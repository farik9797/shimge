ext-orange-600 rounded-2xl w-fit\">\n            <Truck className=\"w-8 h-8\" />\n          </div>\n          <h2 className=\"text-base font-bold text-slate-900\">\320\224\320\276\321\201\321\202\320\260\320\262\320\272\320\260 \320\277\320\276 \320\234\320\270\320\275\321\201\320\272\321\203</h2>\n          <p className=\"text-xs text-slate-600 leading-relaxed\">\n            \320\232\321\203\321\200\321\214\320\265\321\200\321\201\320\272\320\260\321\217 \320\264\320\276\321\201\321\202\320\260\320\262\320\272\320\260 \321\201\320\276\320\261\321\201\321\202\320\262\320\265\320\275\320\275\320\276\320\271 \321\201\320\273\321\203\320\266\320\261\320\276\320\271 mzvuk.by \320\264\320\265\320\275\321\214-\320\262-\320\264\320\265\320\275\321\214 \320\277\321\200\320\270 \320\276\321\204\320\276\321\200\320\274\320\273\320\265\320\275\320\270\320\270 \320\267\320\260\320\272\320\260\320\267\320\260 \320\264\320\276 12:00.\n          </p>\n          <div className=\"text-xs font-bold text-emerald-600 bg-emerald-50 p-2.5 rounded-xl\">\n            \320\221\320\265\321\201\320\277\320\273\320\260\321\202\320\275\320\276 \320\277\321\200\320\270 \320\267\320\260\320\272\320\260\320\267\320\265 \320\276\321\202 300 BYN\n          </div>\n        </div>\n\n        <div className=\"bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-4\">\n          <div className=\"p-3 bg-blue-50 text-blue-600 rounded-2xl w-fit\">\n            <Clock className=\"w-8 h-8\" />\n          </div>\n          <h2 className=\"text-base font-bold text-slate-900\">\320\255\320\272\321\201\320\277\321\200\320\265\321\201\321\201 \320\277\320\276 \320\221\320\265\320\273\320\260\321\200\321\203\321\201\320\270</h2>\n          <p className=\"text-xs text-slate-600 leading-relaxed\">\n            \320\224\320\276\321\201\321\202\320\260\320\262\320\272\320\260 \321\201\320\273\321\203\320\266\320\261\320\276\320\271 DPD \320\270\320\273\320\270 Autolight Express \320\264\320\276 \320\264\