ading-relaxed\">\n          \320\234\321\213 \321\200\320\260\320\267\321\200\320\260\320\261\320\260\321\202\321\213\320\262\320\260\320\265\320\274 \320\270 \321\200\320\265\320\260\320\273\320\270\320\267\321\203\320\265\320\274 \320\277\321\200\320\276\320\265\320\272\321\202\321\213 \320\260\320\272\321\203\321\201\321\202\320\270\321\207\320\265\321\201\320\272\320\276\320\263\320\276 \320\276\321\201\320\275\320\260\321\211\320\265\320\275\320\270\321\217 \320\273\321\216\320\261\320\276\320\271 \321\201\320\273\320\276\320\266\320\275\320\276\321\201\321\202\320\270 \320\264\320\273\321\217 \320\272\320\276\320\274\320\274\320\265\321\200\321\207\320\265\321\201\320\272\320\270\321\205, \320\263\320\276\321\201\321\203\320\264\320\260\321\200\321\201\321\202\320\262\320\265\320\275\320\275\321\213\321\205 \320\270 \321\207\320\260\321\201\321\202\320\275\321\213\321\205 \320\276\320\261\321\212\320\265\320\272\321\202\320\276\320\262 \320\277\320\276 \320\221\320\265\320\273\320\260\321\200\321\203\321\201\320\270.\n        </p>\n      </div>\n\n      {/* Services Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n        {MOCK_SERVICES.map(service => (\n          <div\n            key={service.id}\n            className=\"bg-white rounded-3xl p-8 border border-slate-200 hover:border-orange-500 shadow-sm hover:shadow-xl transition-all flex flex-col justify-between space-y-6\"\n          >\n            <div className=\"space-y-4\">\n              <div className=\"p-4 bg-orange-50 text-orange-600 rounded-2xl w-fit\">\n                {SERVICE_ICONS[service.iconName] || <Wrench className=\"w-8 h-8\" />}\n              </div>\n\n              <h2 className=\"text-xl font-bold text-slate-900\">{service.title}</h2>\n              <p className=\"text-xs text-slate-600 leading-relaxed\">{service.fullDesc}</p>\n\n              <div className=\"space-y-2 pt-2\">\n                <span className=\"text-xs font-bold text-slate-900 block\">\320\247\321\202\320\276 \320\262\321\205\320\276\320\264\320\270\321\202 \320\262 \321\203\321\201\320\273\321\203\320\263\321\203:</span>\n                <ul className=\"space-y-2 text-xs text-slate-600\">\n                  {service.features.map((feat, idx) => (\n                    <li key={idx} className=\"flex items-start gap-2\">\n                      <CheckCircle2 className=\"w-4 h-4 text-emerald-500 shrink-0 mt-0.5\" />\n                      <span>{feat}</span>\n                    </li>\n                  ))}\n                </ul>\n              </div>\n            </div>\n\n            <div className=\"pt-6 border-t border-slate-100 flex items-center justify-between\">\n              <div>\n                <span className=\"text-[10px] text-slate-400 block uppercase font-bold\">\320\241\321\202\320\276\320\270\320\274\320\276\321\201\321\202\321\214</span>\n                <span className=\"text-lg font-black text-slate-900\">\320\276\321\202 {formatPrice(service.priceStartBYN)}</span>\n              </div>\n\n              <button\n                onClick={() => setIsCallbackOpen(true)}\n                className=\"px-6 py-3 bg-orange-600 hover:bg-orange-700 text-white font-bold rounded-xl text-xs shadow-md flex items-center gap-2 transition-all\"\n              >\n                <Phone className=\"w-3.5 h-3.5\" /> \320\227\320\260\320\272\320\260\320\267\320\260\321\202\321\214 \321\203\321\201\320\273\321\203\320\263\321\203\n              </button>\n            </div>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};\n"
