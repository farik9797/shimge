302\273** (\320\270\320\273\320\270 **\302\253Connect to GitHub\302\273**).\n3. \320\243\320\272\320\260\320\266\320\270\321\202\320\265 \320\275\320\260\320\267\320\262\320\260\320\275\320\270\320\265 \320\275\320\276\320\262\320\276\320\263\320\276 \321\200\320\265\320\277\320\276\320\267\320\270\321\202\320\276\321\200\320\270\321\217 \320\270 \320\275\320\260\320\266\320\274\320\270\321\202\320\265 \320\272\320\275\320\276\320\277\320\272\321\203 **Create Repository / Push**.\n4. \320\237\321\200\320\276\320\265\320\272\321\202 \320\260\320\262\321\202\320\276\320\274\320\260\321\202\320\270\321\207\320\265\321\201\320\272\320\270 \320\267\320\260\320\263\321\200\321\203\320\267\320\270\321\202\321\201\321\217 \321\201\320\276 \320\262\321\201\320\265\320\271 \320\270\321\201\321\202\320\276\321\200\320\270\320\265\320\271 \320\270 \321\204\320\260\320\271\320\273\320\276\320\262\320\276\320\271 \321\201\321\202\321\200\321\203\320\272\321\202\321\203\321\200\320\276\320\271 \320\262 \320\262\320\260\321\210 GitHub-\320\260\320\272\320\272\320\260\321\203\320\275\321\202, \320\270 \320\262\321\213 \320\277\320\276\320\273\321\203\321\207\320\270\321\202\320\265 \320\277\321\200\321\217\320\274\321\203\321\216 \321\201\321\201\321\213\320\273\320\272\321\203 \320\275\320\260 \321\200\320\265\320\277\320\276\320\267\320\270\321\202\320\276\321\200\320\270\320\271.\n\n---\n\n\320\242\320\260\320\272\320\266\320\265 \320\262\321\213 \320\274\320\276\320\266\320\265\321\202\320\265:\n- **\320\241\320\272\320\260\321\207\320\260\321\202\321\214 \320\277\320\276\320\273\320\275\321\213\320\271 \320\260\321\200\321\205\320\270\320\262 (ZIP)** \321\207\320\265\321\200\320\265\320\267 \321\202\320\276 \320\266\320\265 \320\274\320\265\320\275\321\216 \320\275\320\260\321\201\321\202\321\200\320\276\320\265\320\272 \320\270 \320\262\321\213\320\263\321\200\321\203\320\267\320\270\321\202\321\214 \320\273\320\276\320\272\320\260\320\273\321\214\320\275\320\276 \321\201 \320