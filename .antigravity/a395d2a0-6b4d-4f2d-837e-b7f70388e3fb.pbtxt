  file_change {
    absolute_path_uri: "file:///src/components/catalog/CatalogFilterSidebar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { MOCK_CATEGORIES, MOCK_PRODUCTS } from \'../../data/mockData\';\nimport { SlidersHorizontal, RotateCcw, Check, ChevronDown } from \'lucide-react\';\nimport { ProductBadge } from \'../../types\';\n\nconst BRANDS = Array.from(new Set(MOCK_PRODUCTS.map(p => p.brand)));\n\nexport const CatalogFilterSidebar: React.FC = () => {\n  const { filters, setFilters, resetFilters, formatPrice } = useApp();\n\n  const handleCategoryChange = (catId: string) => {\n    setFilters(prev => ({ ...prev, category: catId }));\n  };\n\n  const handleBrandToggle = (brand: string) => {\n    setFilters(prev => {\n      const exists = prev.selectedBrands.includes(brand);\n      const updated = exists\n        ? prev.selectedBrands.filter(b => b !== brand)\n        : [...prev.selectedBrands, brand];\n      return { ...prev, selectedBrands: updated };\n    });\n  };\n\n  const handleBadgeToggle = (badge: ProductBadge) => {\n    setFilters(prev => {\n      const exists = prev.badges.includes(badge);\n      const updated = exists\n        ? prev.badges.filter(b => b !== badge)\n        : [...prev.badges, badge];\n      return { ...prev, badges: updated };\n    });\n  };\n\n  return (\n    <aside className=\"bg-white rounded-2xl p-5 border border-slate-200 space-y-6\">\n      <div className=\"flex items-center justify-between pb-3 border-b border-slate-100\">\n        <div className=\"flex items-center gap-2 font-bold text-slate-900 text-sm\">\n          <SlidersHorizontal className=\"w-4 h-4 text-orange-600\" />\n          <span>\320\244\320\270\320\273\321\214\321\202\321\200\321\213 \320\272\320\260\321\202\320\260\320\273\320\276\320\263\320\260</span>\n        </div>\n        <button\n          onClick={resetFilters}\n          className=\"text-[11px] font-bold text-slate-400 hover:text-orange-600 flex items-center gap-1 transition-colors\"\n          title=\"\320\241\320\261\321\200\320\276\321\201\320\270\321\202\321\214 \320\262\321\201\320\265 \321\204\320\270\320\273\321\214\321\202\321\200\321\213\"\n        >\n          <RotateCcw className=\"w-3 h-3\" /> \320\241\320\261\321\200\320\276\321\201\320\270\321\202\321\214\n        </button>\n      </div>\n\n      {/* Category List */}\n      <div>\n        <h4 className=\"text-xs font-bold uppercase tracking-wider text-slate-700 mb-2\">\320\232\320\260\321\202\320\265\320\263\320\276\321\200\320\270\320\270</h4>\n        <div className=\"space-y-1 text-xs font-semibold\">\n          <button\n            onClick={() => handleCategoryChange(\'all\')}\n            className={`w-full text-left px-3 py-2 rounded-xl transition-colors flex items-center justify-between ${\n              filters.category === \'all\'\n                ? \'bg-orange-600 text-white font-bold\'\n                : \'text-slate-700 hover:bg-slate-100\'\n            }`}\n          >\n            <span>\320\222\321\201\320\265 \320\272\320\260\321\202\320\265\320\263\320\276\321\200\320\270\320\270</span>\n            <span className=\"text-[10px] opacity-80\">{MOCK_PRODUCTS.length}</span>\n          </button>\n          {MOCK_CATEGORIES.map(cat => (\n            <button\n              key={cat.id}\n              onClick={() => handleCategoryChange(cat.id)}\n              className={`w-full text-left px-3 py-2 rounded-xl transition-colors flex items-center justify-between ${\n                filters.category === cat.id\n                  ? \'bg-orange-600 text-white font-bold\'\n                  : \'text-slate-700 hover:bg-slate-100\'\n              }`}\n            >\n              <span className=\"truncate\">{cat.name}</span>\n              <span className=\"text-[10px] opacity-70 ml-2\">{cat.productCount}</span>\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Price Range Slider */}\n      <div className=\"pt-2 border-t border-slate-100\">\n        <h4 className=\"text-xs font-bold uppercase tracking-wider text-slate-700 mb-2\">\n          \320\246\320\265\320\275\320\260 (BYN)\n        </h4>\n        <div className=\"flex items-center gap-2 mb-3\">\n          <input\n            type=\"number\"\n            value={filters.priceRange[0]}\n            onChange={e =>\n              setFilters(prev => ({\n                ...prev,\n                priceRange: [Number(e.target.value), prev.priceRange[1]]\n              }))\n            }\n            className=\"w-full px-2.5 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs outline-none focus:border-orange-500 font-bold\"\n            placeholder=\"\320\236\321\202\"\n          />\n          <span className=\"text-slate-400 font-bold\">\342\200\224</span>\n          <input\n            type=\"number\"\n            value={filters.priceRange[1]}\n            onChange={e =>\n              setFilters(prev => ({\n                ...prev,\n                priceRange: [prev.priceRange[0], Number(e.target.value)]\n              }))\n            }\n            className=\"w-full px-2.5 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs outline-none focus:border-orange-500 font-bold\"\n            placeholder=\"\320\224\320\276\"\n          />\n        </div>\n      </div>\n\n      {/* Brand Checkboxes */}\n      <div className=\"pt-2 border-t border-slate-100\">\n        <h4 className=\"text-xs font-bold uppercase tracking-wider text-slate-700 mb-2\">\320\221\321\200\320\265\320\275\320\264</h4>\n        <div className=\"space-y-1.5 max-h-48 overflow-y-auto pr-1\">\n          {BRANDS.map(brand => {\n            const checked = filters.selectedBrands.includes(brand);\n            return (\n              <label\n                key={brand}\n                className=\"flex items-center gap-2 text-xs font-semibold text-slate-700 cursor-pointer hover:text-orange-600\"\n              >\n                <input\n                  type=\"checkbox\"\n                  checked={checked}\n                  onChange={() => handleBrandToggle(brand)}\n                  className=\"rounded text-orange-600 focus:ring-orange-500 w-4 h-4\"\n                />\n                <span>{brand}</span>\n              </label>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* Badges Filter */}\n      <div className=\"pt-2 border-t border-slate-100\">\n        <h4 className=\"text-xs font-bold uppercase tracking-wider text-slate-700 mb-2\">\320\234\320\265\321\202\320\272\320\270</h4>\n        <div className=\"space-y-1.5\">\n          {[\n            { id: \'DISCOUNT\' as ProductBadge, label: \'\320\241\320\276 \321\201\320\272\320\270\320\264\320\272\320\276\320\271 (-%)\', color: \'text-rose-600\' },\n            { id: \'HIT\' as ProductBadge, label: \'\320\245\320\270\321\202\321\213 \320\277\321\200\320\276\320\264\320\260\320\266 (HIT)\', color: \'text-amber-600\' },\n            { id: \'NEW\' as ProductBadge, label: \'\320\235\320\276\320\262\320\270\320\275\320\272\320\270 (NEW)\', color: \'text-emerald-600\' },\n          ].map(badge => {\n            const checked = filters.badges.includes(badge.id);\n            return (\n              <label\n                key={badge.id}\n                className=\"flex items-center gap-2 text-xs font-semibold text-slate-700 cursor-pointer hover:text-orange-600\"\n              >\n                <input\n                  type=\"checkbox\"\n                  checked={checked}\n                  onChange={() => handleBadgeToggle(badge.id)}\n                  className=\"rounded text-orange-600 focus:ring-orange-500 w-4 h-4\"\n                />\n                <span className={badge.color}>{badge.label}</span>\n              </label>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* In Stock Only Toggle */}\n      <div className=\"pt-2 border-t border-slate-100\">\n        <label className=\"flex items-center justify-between text-xs font-bold text-slate-800 cursor-pointer\">\n          <span>\320\242\320\276\320\273\321\214\320\272\320\276 \320\262 \320\275\320\260\320\273\320\270\321\207\320\270\320\270</span>\n          <input\n            type=\"checkbox\"\n            checked={filters.onlyInStock}\n            onChange={e =>\n              setFilters(prev => ({ ...prev, onlyInStock: e.target.checked }))\n            }\n            className=\"w-4 h-4 text-orange-600 rounded focus:ring-orange-500\"\n          />\n        </label>\n      </div>\n    </aside>\n  );\n};\n"
