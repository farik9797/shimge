  file_change {
    absolute_path_uri: "file:///src/components/common/QuickBuyModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { X, Zap, Phone, User, CheckCircle2, ShoppingBag } from \'lucide-react\';\n\nexport const QuickBuyModal: React.FC = () => {\n  const { quickBuyProduct, setQuickBuyProduct, formatPrice, showNotification } = useApp();\n  const [phone, setPhone] = useState(\'\');\n  const [name, setName] = useState(\'\');\n  const [qty, setQty] = useState(1);\n  const [isSuccess, setIsSuccess] = useState(false);\n\n  if (!quickBuyProduct) return null;\n\n  const handleQuickSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!phone) {\n      showNotification(\'\320\243\320\272\320\260\320\266\320\270\321\202\320\265 \320\272\320\276\320\275\321\202\320\260\320\272\321\202\320\275\321\213\320\271 \320\275\320\276\320\274\320\265\321\200 \321\202\320\265\320\273\320\265\321\204\320\276\320\275\320\260\', \'error\');\n      return;\n    }\n    setIsSuccess(true);\n    showNotification(\'\320\221\321\213\321\201\321\202\321\200\321\213\320\271 \320\267\320\260\320\272\320\260\320\267 \320\276\321\204\320\276\321\200\320\274\320\273\320\265\320\275! \320\235\320\260\321\210 \321\201\320\277\320\265\321\206\320\270\320\260\320\273\320\270\321\201\321\202 \321\201\320\262\321\217\320\266\320\265\321\202\321\201\321\217 \321\201 \320\262\320\260\320\274\320\270.\', \'success\');\n    setTimeout(() => {\n      setIsSuccess(false);\n      setQuickBuyProduct(null);\n      setPhone(\'\');\n      setName(\'\');\n      setQty(1);\n    }, 2500);\n  };\n\n  const totalPrice = quickBuyProduct.priceBYN * qty;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/70 backdrop-blur-sm animate-fade-in\">\n      <div className=\"relative w-full max-w-lg bg-white rounded-2xl shadow-2xl overflow-hidden border border-slate-200\">\n        <div className=\"bg-slate-900 text-white p-6 relative\">\n          <button\n            onClick={() => setQuickBuyProduct(null)}\n            className=\"absolute top-5 right-5 p-1 text-slate-400 hover:text-white rounded-full bg-slate-800/80 transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-500/20 text-orange-400 text-xs font-bold uppercase mb-2\">\n            <Zap className=\"w-3.5 h-3.5\" /> \320\221\321\213\321\201\321\202\321\200\321\213\320\271 \320\267\320\260\320\272\320\260\320\267 \320\262 1 \320\272\320\273\320\270\320\272\n          </div>\n          <h3 className=\"text-lg font-bold line-clamp-1\">{quickBuyProduct.name}</h3>\n          <p className=\"text-slate-300 text-xs mt-1\">\n            \320\220\321\200\321\202\320\270\320\272\321\203\320\273: {quickBuyProduct.sku} \342\200\242 \320\222 \320\275\320\260\320\273\320\270\321\207\320\270\320\270 \320\275\320\260 \321\201\320\272\320\273\320\260\320\264\320\265\n          </p>\n        </div>\n\n        <div className=\"p-6\">\n          {isSuccess ? (\n            <div className=\"text-center py-8\">\n              <CheckCircle2 className=\"w-16 h-16 text-emerald-500 mx-auto mb-4 animate-bounce\" />\n              <h4 className=\"text-lg font-bold text-slate-900\">\320\227\320\260\320\272\320\260\320\267 \321\203\321\201\320\277\320\265\321\210\320\275\320\276 \320\277\321\200\320\270\320\275\321\217\321\202!</h4>\n              <p className=\"text-sm text-slate-600 mt-2\">\n                \320\235\320\276\320\274\320\265\321\200 \320\267\320\260\320\272\320\260\320\267\320\260: <strong className=\"text-slate-900\">#BY-{Math.floor(100000 + Math.random() * 900000)}</strong>\n              </p>\n              <p className=\"text-xs text-slate-500 mt-1\">\n                \320\234\321\213 \320\277\320\276\320\267\320\262\320\276\320\275\320\270\320\274 \320\275\320\260 {phone} \320\262 \321\202\320\265\321\207\320\265\320\275\320\270\320\265 10 \320\274\320\270\320\275\321\203\321\202 \320\264\320\273\321\217 \321\203\321\202\320\276\321\207\320\275\320\265\320\275\320\270\321\217 \320\260\320\264\321\200\320\265\321\201\320\260 \320\264\320\276\321\201\321\202\320\260\320\262\320\272\320\270.\n              </p>\n            </div>\n          ) : (\n            <form onSubmit={handleQuickSubmit} className=\"space-y-4\">\n              <div className=\"flex items-center gap-4 p-3 bg-slate-50 rounded-xl border border-slate-200\">\n                <img\n                  src={quickBuyProduct.image}\n                  alt={quickBuyProduct.name}\n                  className=\"w-16 h-16 object-cover rounded-lg bg-white shrink-0 border\"\n                />\n                <div className=\"flex-1 min-w-0\">\n                  <h4 className=\"text-xs font-semibold text-slate-900 line-clamp-2\">{quickBuyProduct.name}</h4>\n                  <div className=\"flex items-center justify-between mt-1\">\n                    <span className=\"text-sm font-bold text-orange-600\">{formatPrice(quickBuyProduct.priceBYN)}</span>\n                    <div className=\"flex items-center gap-2 bg-white border rounded-lg px-2 py-0.5\">\n                      <button\n                        type=\"button\"\n                        onClick={() => setQty(Math.max(1, qty - 1))}\n                        className=\"text-slate-500 font-bold px-1\"\n                      >\n                        -\n                      </button>\n                      <span className=\"text-xs font-bold w-4 text-center\">{qty}</span>\n                      <button\n                        type=\"button\"\n                        onClick={() => setQty(qty + 1)}\n                        className=\"text-slate-500 font-bold px-1\"\n                      >\n                        +\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1\">\n                  \320\230\320\274\321\217\n                </label>\n                <div className=\"relative\">\n                  <User className=\"w-4 h-4 text-slate-400 absolute left-3 top-3.5\" />\n                  <input\n                    type=\"text\"\n                    value={name}\n                    onChange={e => setName(e.target.value)}\n                    placeholder=\"\320\220\320\273\320\265\320\272\321\201\320\260\320\275\320\264\321\200\"\n                    className=\"w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-orange-500 focus:bg-white outline-none\"\n                  />\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1\">\n                  \320\242\320\265\320\273\320\265\321\204\320\276\320\275 *\n                </label>\n                <div className=\"relative\">\n                  <Phone className=\"w-4 h-4 text-slate-400 absolute left-3 top-3.5\" />\n                  <input\n                    type=\"tel\"\n                    required\n                    value={phone}\n                    onChange={e => setPhone(e.target.value)}\n                    placeholder=\"+375 (33) 377-28-73\"\n                    className=\"w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-orange-500 focus:bg-white outline-none\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"p-3 bg-orange-50 rounded-xl border border-orange-200 flex items-center justify-between\">\n                <span className=\"text-xs font-bold text-slate-700\">\320\230\321\202\320\276\320\263\320\276 \320\272 \320\276\320\277\320\273\320\260\321\202\320\265:</span>\n                <span className=\"text-lg font-extrabold text-orange-600\">{formatPrice(totalPrice)}</span>\n              </div>\n\n              <button\n                type=\"submit\"\n                className=\"w-full py-3 px-6 bg-orange-600 hover:bg-orange-700 text-white font-semibold rounded-xl shadow-lg shadow-orange-500/25 flex items-center justify-center gap-2 transition-all\"\n              >\n                <ShoppingBag className=\"w-4 h-4\" />\n                \320\237\320\276\320\264\321\202\320\262\320\265\321\200\320\264\320\270\321\202\321\214 \320\267\320\260\320\272\320\260\320\267 ({formatPrice(totalPrice)})\n              </button>\n            </form>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
