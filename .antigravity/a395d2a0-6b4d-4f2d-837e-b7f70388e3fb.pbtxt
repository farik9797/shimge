    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { OrderData } from \'../../types\';\nimport { Building2, User, FileText, CheckCircle2, ShieldCheck, Printer, ArrowRight, Truck, Phone, Mail } from \'lucide-react\';\n\nexport const CheckoutPage: React.FC = () => {\n  const { cart, cartTotalBYN, formatPrice, addPlacedOrder, setRoute, showNotification } = useApp();\n\n  const [customerType, setCustomerType] = useState<\'b2b\' | \'b2c\'>(\'b2b\');\n  const [fullName, setFullName] = useState(\'\');\n  const [phone, setPhone] = useState(\'+375 \');\n  const [email, setEmail] = useState(\'\');\n\n  // B2B Details\n  const [companyName, setCompanyName] = useState(\'\320\236\320\236\320\236 \');\n  const [unp, setUnp] = useState(\'\');\n  const [bik, setBik] = useState(\'AKBBBY2X\');\n  const [bankAccount, setBankAccount] = useState(\'BY00AKBB30120000000000000000\');\n\n  // Address & Delivery\n  const [city, setCity] = useState(\'\320\234\320\270\320\275\321\201\320\272\');\n  const [address, setAddress] = useState(\'\');\n  const [deliveryMethod, setDeliveryMethod] = useState(\'courier\');\n  const [paymentMethod, setPaymentMethod] = useState(\'bank_transfer\');\n  const [comment, setComment] = useState(\'\');\n\n  const [placedOrderSuccess, setPlacedOrderSuccess] = useState<OrderData | null>(null);\n\n  if (cart.length === 0 && !placedOrderSuccess) {\n    return (\n      <div className=\"max-w-4xl mx-auto px-4 py-16 text-center space-y-4\">\n        <h2 className=\"text-xl font-bold text-slate-800\">\320\232\320\276\321\200\320\267\320\270\320\275\320\260 \320\277\321\203\321\201\321\202\320\260</h2>\n        <button\n          onClick={() => setRoute(\'catalog\')}\n          className=\"px-6 py-2.5 bg-orange-600 text-white font-bold rounded-xl text-xs\"\n        >\n          \320\237\320\265\321\200\320\265\320\271\321\202\320\270 \320\262 \320\272\320\260\321\202\320\260\320\273\320\276\320\263\n        </button>\n      </div>\n    );\n  }\n\n  const handleSubmitOrder = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!phone || !fullName) return;\n\n    const newOrder: OrderData = {\n      orderId: `BY-MZVUK-${Math.floor(100000 + Math.random() * 900000)}`,\n      customerType,\n      fullName,\n      phone,\n      email,\n      companyName: customerType === \'b2b\' ? companyName : undefined,\n      unp: customerType === \'b2b\' ? unp : undefined,\n      bik: customerType === \'b2b\' ? bik : undefined,\n      bankAccount: customerType === \'b2b\' ? bankAccount : undefined,\n      address,\n      city,\n      deliveryMethod,\n      paymentMethod,\n      comment,\n      items: [...cart],\n      totalBYN: cartTotalBYN,\n      discountBYN: 0,\n      date: new Date().toLocaleDateString(\'ru-RU\')\n    };\n\n    addPlacedOrder(newOrder);\n    setPlacedOrderSuccess(newOrder);\n    showNotification(`\320\227\320\260\320\272\320\260\320\267 ${newOrder.orderId} \321\203\321\201\320\277\320\265\321\210\320\275\320\276 \321\201\320\276\320\267\320\264\320\260\320\275!`, \'success\');\n  };\n\n  if (placedOrderSuccess) {\n    return (\n      <div className=\"max-w-4xl mx-auto px-4 py-10 animate-fade-in space-y-8\">\n        <div className=\"bg-emerald-50 border border-emerald-200 rounded-3xl p-8 text-center space-y-4\">\n          <div className=\"p-4 bg-emerald-500 text-white rounded-full w-fit mx-auto shadow-lg\">\n            <CheckCircle2 className=\"w-12 h-12\" />\n          </div>\n          <h1 className=\"text-2xl font-black text-emerald-900\">\n            \320\227\320\260\320\272\320\260\320\267 \321\203\321\201\320\277\320\265\321\210\320\275\320\276 \320\277\321\200\320\270\320\275\321\217\321\202 \320\262 \320\276\320\261\321\200\320\260\320\261\320\276\321\202\320\272\321\203!\n          </h1>\n          <p className=\"text-xs text-emerald-800 max-w-lg mx-auto leading-relaxed\">\n            \320\235\320\276\320\274\320\265\321\200 \320\262\320\260\321\210\320\265\320\263\320\276 \320\267\320\260\320\272\320\260\320\267\320\260: <strong className=\"font-mono text-slate-900\">{placedOrderSuccess.orderId}</strong>. \320\235\320\260\321\210 \320\274\320\265\320\275\320\265\320\264\320\266\320\265\321\200 \321\201\320\262\321\217\320\266\320\265\321\202\321\201\321\217 \321\201 \320\262\320\260\320\274\320\270 \320\277\320\276 \321\202\320\265\320\273\320\265\321\204\320\276\320\275\321\203 {placedOrderSuccess.phone} \320\262 \321\202\320\265\321\207\320\265\320\275\320\270\320\265 15 \320\274\320\270\320\275\321\203\321\202 \320\264\320\273\321\217 \320\277\320\276\320\264\321\202\320\262\320\265\321\200\320\266\320\264\320\265\320\275\320\270\321\217.\n          </p>\n\n          <button\n            onClick={() => window.print()}\n            className=\"px-6 py-2.5 bg-slate-900 text-white font-bold rounded-xl text-xs inline-flex items-center gap-2 shadow\"\n          >\n            <Printer className=\"w-4 h-4 text-orange-400\" /> \320\240\320\260\321\201\320\277\320\265\321\207\320\260\321\202\320\260\321\202\321\214 \321\201\321\207\321\221\321\202-\321\204\320\260\320\272\321\202\321\203\321\200\321\203\n          </button>\n        </div>\n\n        {/* Commercial Invoice Preview Card */}\n        <div className=\"bg-white rounded-3xl p-8 border border-slate-200 space-y-6 shadow-sm printable-invoice\">\n          <div className=\"flex justify-between items-start border-b border-slate-200 pb-6\">\n            <div>\n              <span className=\"text-xl font-black text-slate-900 font-mono tracking-wider\">\n                mzvuk.by\n              </span>\n              <p className=\"text-xs text-slate-500 mt-1\">\n                \320\237\320\276\321\201\321\202\320\260\320\262\321\211\320\270\320\272: \320\236\320\236\320\236 \302\253\320\220\321\200\321\202-\320\234\320\265\320\264\320\270\320\260 \320\242\321\200\320\265\320\271\320\264\302\273, \320\243\320\235\320\237 193... <br />\n                220000, \320\240\320\265\321\201\320\277\321\203\320\261\320\273\320\270\320\272\320\260 \320\221\320\265\320\273\320\260\321\200\321\203\321\201\321\214, \320\263. \320\234\320\270\320\275\321\201\320\272\n              </p>\n            </div>\n            <div className=\"text-right\">\n              <span className=\"text-xs font-bold text-orange-600 block\">\n                \320\241\321\207\321\221\321\202-\321\204\320\260\320\272\321\202\321\203\321\200\320\260 \342\204\226 {placedOrderSuccess.orderId}\n              </span>\n              <span className=\"text-[11px] text-slate-400 block\">\n                \320\224\320\260\321\202\320\260 \321\201\321\207\320\265\321\202\320\260: {placedOrderSuccess.date}\n              </span>\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-4 text-xs\">\n            <div className=\"p-4 bg-slate-50 rounded-2xl border border-slate-100 space-y-1\">\n              <span className=\"font-bold text-slate-800 block\">\320\237\320\276\320\272\321\203\320\277\320\260\321\202\320\265\320\273\321\214:</span>\n              <p className=\"text-slate-600\">\n                {placedOrderSuccess.companyName || placedOrderSuccess.fullName} <br />\n                {placedOrderSuccess.unp && `\320\243\320\235\320\237: ${placedOrderSuccess.unp}`} <br />\n                \320\220\320\264\321\200\320\265\321\201: {placedOrderSuccess.city}, {placedOrderSuccess.address}\n              </p>\n            </div>\n            <div className=\"p-4 bg-slate-50 rounded-2xl border border-slate-100 space-y-1\">\n              <span className=\"font-bold text-slate-800 block\">\320\232\320\276\320\275\321\202\320\260\320\272\321\202\321\213:</span>\n              <p className=\"text-slate-600\">\n                \320\242\320\265\320\273\320\265\321\204\320\276\320\275: {placedOrderSuccess.phone} <br />\n                Email: {placedOrderSuccess.email || \'\342\200\224\'}\n              </p>\n            </div>\n          </div>\n\n          {/* Invoice Items Table */}\n          <table className=\"w-full text-xs text-left border-collapse\">\n            <thead>\n              <tr className=\"bg-slate-100 text-slate-700 font-bold border-b border-slate-200\">\n                <th className=\"p-3\">\342\204\226</th>\n                <th className=\"p-3\">\320\235\320\260\320\270\320\274\320\265\320\275\320\276\320\262\320\260\320\275\320\270\320\265 \321\202\320\276\320\262\320\260\321\200\320\260 / \321\203\321\201\320\273\321\203\320\263\320\270</th>\n                <th className=\"p-3 text-center\">\320\232\320\276\320\273-\320\262\320\276</th>\n                <th className=\"p-3 text-right\">\320\246\320\265\320\275\320\260 \321\201 \320\235\320\224\320\241</th>\n                <th className=\"p-3 text-right\">\320\241\321\203\320\274\320\274\320\260 \321\201 \320\235\320\224\320\241</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100\">\n              {placedOrderSuccess.items.map((item, idx) => (\n                <tr key={idx}>\n                  <td className=\"p-3 text-slate-400 font-mono\">{idx + 1}</td>\n                  <td className=\"p-3 font-bold text-slate-900\">{item.product.name}</td>\n                  <td className=\"p-3 text-center\">{item.quantity}</td>\n                  <td className=\"p-3 text-right\">{formatPrice(item.product.priceBYN)}</td>\n                  <td className=\"p-3 text-right font-bold\">\n                    {formatPrice(item.product.priceBYN * item.quantity)}\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n\n          <div className=\"border-t border-slate-200 pt-4 flex flex-col items-end space-y-1 text-xs\">\n            <div className=\"flex justify-between w-64\">\n              <span className=\"text-slate-500\">\320\241\321\203\320\274\320\274\320\260 \320\261\320\265\320\267 \320\235\320\224\320\241:</span>\n              <span className=\"font-bold\">{formatPrice(placedOrderSuccess.totalBYN * 0.8333)}</span>\n            </div>\n            <div className=\"flex justify-between w-64\">\n              <span className=\"text-slate-500\">\320\241\321\202\320\260\320\262\320\272\320\260 \320\235\320\224\320\241:</span>\n              <span className=\"font-bold text-orange-600\">20%</span>\n            </div>\n            <div className=\"flex justify-between w-64 text-sm font-black pt-2 border-t border-slate-200\">\n              <span>\320\222\321\201\320\265\320\263\320\276 \320\272 \320\276\320\277\320\273\320\260\321\202\320\265:</span>\n              <span className=\"text-orange-600\">{formatPrice(placedOrderSuccess.totalBYN)}</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 py-8 animate-fade-in space-y-8\">\n      <div>\n        <h1 className=\"text-2xl font-black text-slate-900\">\320\236\321\204\320\276\321\200\320\274\320\273\320\265\320\275\320\270\320\265 \320\267\320\260\320\272\320\260\320\267\320\260</h1>\n        <p className=\"text-xs text-slate-500 mt-1\">\n          \320\227\320\260\320\277\320\276\320\273\320\275\320\265\320\275\320\270\320\265 \320\264\320\260\320\275\320\275\321\213\321\205 \320\264\320\273\321\217 \321\204\320\270\320\267\320\270\321\207\320\265\321\201\320\272\320\270\321\205 \320\273\320\270\321\206 \320\270 \320\277\320\273\320\260\321\202\320\265\320\273\321\214\321\211\320\270\320\272\320\276\320\262 \320\235\320\224\320\241 \320\240\320\265\321\201\320\277\321\203\320\261\320\273\320\270\320\272\320\270 \320\221\320\265\320\273\320\260\321\200\321\203\321\201\321\214\n        </p>\n      </div>\n\n      <form onSubmit={handleSubmitOrder} className=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n        <div className=\"lg:col-span-2 space-y-6\">\n          {/* Customer Type Selector */}\n          <div className=\"bg-white rounded-3xl p-6 border border-slate-200 space-y-4 shadow-sm\">\n            <h2 className=\"text-sm font-bold text-slate-900 uppercase tracking-wider\">\n              1. \320\222\321\213\320\261\320\265\321\200\320\270\321\202\320\265 \321\202\320\270\320\277 \320\277\320\273\320\260\321\202\320\265\320\273\321\214\321\211\320\270\320\272\320\260\n            </h2>\n\n            <div className=\"grid grid-cols-2 gap-4\">\n              <button\n                type=\"button\"\n                onClick={() => setCustomerType(\'b2b\')}\n                className={`p-4 rounded-2xl border flex items-center gap-3 transition-all ${\n                  customerType === \'b2b\'\n                    ? \'bg-orange-600 border-orange-500 text-white shadow-md\'\n                    : \'bg-slate-50 border-slate-200 text-slate-700 hover:bg-slate-100\'\n                }`}\n              >\n                <Building2 className=\"w-5 h-5 shrink-0\" />\n                <div className=\"text-left\">\n                  <span className=\"text-xs font-extrabold block\">\320\256\321\200\320\270\320\264\320\270\321\207\320\265\321\201\320\272\320\276\320\265 \320\273\320\270\321\206\320\276 / \320\230\320\237</span>\n                  <span className=\"text-[10px] opacity-80 block\">\320\221\320\265\320\267\320\275\320\260\320\273\320\270\321\207\320\275\321\213\320\271 \321\200\320\260\321\201\321\207\320\265\321\202 \321\201 \320\235\320\224\320\241 20%</span>\n                </div>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={() => setCustomerType(\'b2c\')}\n                className={`p-4 rounded-2xl border flex items-center gap-3 transition-all ${\n                  customerType === \'b2c\'\n                    ? \'bg-orange-600 border-orange-500 text-white shadow-md\'\n                    : \'bg-slate-50 border-slate-200 text-slate-700 hover:bg-slate-100\'\n                }`}\n              >\n                <User className=\"w-5 h-5 shrink-0\" />\n                <div className=\"text-left\">\n                  <span className=\"text-xs font-extrabold block\">\320\247\320\260\321\201\321\202\320\275\320\276\320\265 \320\273\320\270\321\206\320\276</span>\n                  <span className=\"text-[10px] opacity-80 block\">\320\225\320\240\320\230\320\237 / \320\232\320\260\321\200\321\202\320\260 / \320\235\320\260\320\273\320\270\321\207\320\275\321\213\320\265</span>\n                </div>\n              </button>\n            </div>\n          </div>\n\n          {/* Contact Details Block */}\n          <div className=\"bg-white rounded-3xl p-6 border border-slate-200 space-y-4 shadow-sm\">\n            <h2 className=\"text-sm font-bold text-slate-900 uppercase tracking-wider\">\n              2. \320\232\320\276\320\275\321\202\320\260\320\272\321\202\320\275\320\260\321\217 \320\270\320\275\321\204\320\276\321\200\320\274\320\260\321\206\320\270\321\217\n            </h2>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs\">\n              <div>\n                <label className=\"block font-bold text-slate-700 mb-1\">\n                  \320\244\320\230\320\236 \320\232\320\276\320\275\321\202\320\260\320\272\321\202\320\275\320\276\320\263\320\276 \320\273\320\270\321\206\320\260 *\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  value={fullName}\n                  onChange={e => setFullName(e.target.value)}\n                  placeholder=\"\320\230\320\262\320\260\320\275\320\276\320\262 \320\230\320\262\320\260\320\275 \320\230\320\262\320\260\320\275\320\276\320\262\320\270\321\207\"\n                  className=\"w-full p-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:border-orange-500 font-semibold\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block font-bold text-slate-700 mb-1\">\n                  \320\235\320\276\320\274\320\265\321\200 \321\202\320\265\320\273\320\265\321\204\320\276\320\275\320\260 *\n                </label>\n                <input\n                  type=\"tel\"\n                  required\n                  value={phone}\n                  onChange={e => setPhone(e.target.value)}\n                  placeholder=\"+375 (29) 123-45-67\"\n                  className=\"w-full p-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:border-orange-500 font-semibold\"\n                />\n              </div>\n\n              <div className=\"sm:col-span-2\">\n                <label className=\"block font-bold text-slate-700 mb-1\">\n                  \320\255\320\273\320\265\320\272\321\202\321\200\320\276\320\275\320\275\320\260\321\217 \320\277\320\276\321\207\321\202\320\260 (Email \320\264\320\273\321\217 \321\201\321\207\320\265\321\202\320\260)\n                </label>\n                <input\n                  type=\"email\"\n                  value={email}\n                  onChange={e => setEmail(e.target.value)}\n                  placeholder=\"b2b@company.by\"\n                  className=\"w-full p-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:border-orange-500 font-semibold\"\n                />\n              </div>\n            </div>\n          </div>\n\n          {/* B2B Requisites (if b2b) */}\n          {customerType === \'b2b\' && (\n            <div className=\"bg-white rounded-3xl p-6 border border-slate-200 space-y-4 shadow-sm\">\n              <div className=\"flex items-center justify-between\">\n                <h2 className=\"text-sm font-bold text-slate-900 uppercase tracking-wider\">\n                  3. \320\240\320\265\320\272\320\262\320\270\320\267\320\270\321\202\321\213 \320\276\321\200\320\263\320\260\320\275\320\270\320\267\320\260\321\206\320\270\320\270 \320\264\320\273\321\217 \320\241\321\207\321\221\321\202\320\260\n                </h2>\n                <span className=\"text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full\">\n                  \320\220\320\262\321\202\320\276-\320\263\320\265\320\275\320\265\321\200\320\260\321\206\320\270\321\217 \320\242\320\242\320\235 \320\270 \320\255\320\241\320\247\320\244\n                </span>\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs\">\n                <div>\n                  <label className=\"block font-bold text-slate-700 mb-1\">\n                    \320\235\320\260\320\270\320\274\320\265\320\275\320\276\320\262\320\260\320\275\320\270\320\265 \320\276\321\200\320\263\320\260\320\275\320\270\320\267\320\260\321\206\320\270\320\270 / \320\230\320\237 *\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={companyName}\n                    onChange={e => setCompanyName(e.target.value)}\n                    placeholder=\"\320\236\320\236\320\236 \302\253\320\220\321\203\320\264\320\270\320\276\320\242\320\265\321\205\320\275\320\276\302\273\"\n                    className=\"w-full p-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:border-orange-500 font-semibold\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block font-bold text-slate-700 mb-1\">\n                    \320\243\320\235\320\237 (9 \321\206\320\270\321\204\321\200) *\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    maxLength={9}\n                    value={unp}\n                    onChange={e => setUnp(e.target.value)}\n                    placeholder=\"193123456\"\n                    className=\"w-full p-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:border-orange-500 font-mono font-bold\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block font-bold text-slate-700 mb-1\">\n                    \320\240\320\260\321\201\321\207\320\265\321\202\320\275\321\213\320\271 \321\201\321\207\320\265\321\202 IBAN\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={bankAccount}\n                    onChange={e => setBankAccount(e.target.value)}\n                    className=\"w-full p-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:border-orange-500 font-mono text-[11px]\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block font-bold text-slate-700 mb-1\">\n                    \320\221\320\230\320\232 \320\261\320\260\320\275\320\272\320\260 (BIC)\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={bik}\n                    onChange={e => setBik(e.target.value)}\n                    className=\"w-full p-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:border-orange-500 font-mono\"\n                  />\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* Delivery & Payment Options */}\n          <div className=\"bg-white rounded-3xl p-6 border border-slate-200 space-y-4 shadow-sm\">\n            <h2 className=\"text-sm font-bold text-slate-900 uppercase tracking-wider\">\n              {customerType === \'b2b\' ? \'4. \320\224\320\276\321\201\321\202\320\260\320\262\320\272\320\260 \320\270 \320\232\320\276\320\274\320\274\320\265\320\275\321\202\320\260\321\200\320\270\320\271\' : \'3. \320\224\320\276\321\201\321\202\320\260\320\262\320\272\320\260 \320\270 \320\241\320\277\320\276\321\201\320\276\320\261 \320\276\320\277\320\273\320\260\321\202\321\213\'}\n            </h2>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs\">\n              <div>\n                <label className=\"block font-bold text-slate-700 mb-1\">\320\223\320\276\321\200\320\276\320\264 \320\275\320\260\320\267\320\275\320\260\321\207\320\265\320\275\320\270\321\217</label>\n                <input\n                  type=\"text\"\n                  required\n                  value={city}\n                  onChange={e => setCity(e.target.value)}\n                  placeholder=\"\320\234\320\270\320\275\321\201\320\272\"\n                  className=\"w-full p-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:border-orange-500 font-semibold\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block font-bold text-slate-700 mb-1\">\320\220\320\264\321\200\320\265\321\201 \320\264\320\276\321\201\321\202\320\260\320\262\320\272\320\270 / \320\276\320\261\321\212\320\265\320\272\321\202\320\260</label>\n                <input\n                  type=\"text\"\n                  required\n                  value={address}\n                  onChange={e => setAddress(e.target.value)}\n                  placeholder=\"\321\203\320\273. \320\235\320\265\320\274\320\270\320\263\320\260, \320\264. 5\"\n                  className=\"w-full p-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:border-orange-500 font-semibold\"\n                />\n              </div>\n\n              <div className=\"sm:col-span-2\">\n                <label className=\"block font-bold text-slate-700 mb-1\">\320\232\320\276\320\274\320\274\320\265\320\275\321\202\320\260\321\200\320\270\320\271 \320\272 \320\267\320\260\320\272\320\260\320\267\321\203</label>\n                <textarea\n                  rows={2}\n                  value={comment}\n                  onChange={e => setComment(e.target.value)}\n                  placeholder=\"\320\243\320\272\320\260\320\266\320\270\321\202\320\265 \320\276\321\201\320\276\320\261\321\213\320\265 \321\203\321\201\320\273\320\276\320\262\320\270\321\217 \320\277\320\276 \320\264\320\276\321\201\321\202\320\260\320\262\320\272\320\265 \320\270\320\273\320\270 \320\274\320\276\320\275\321\202\320\260\320\266\321\203...\"\n                  className=\"w-full p-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:border-orange-500 resize-none font-semibold\"\n                />\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Order Review Sidebar */}\n        <div className=\"bg-white rounded-3xl p-6 border border-slate-200 h-fit space-y-6 shadow-sm\">\n          <h2 className=\"text-base font-bold text-slate-900 border-b border-slate-100 pb-3\">\n            \320\222\320\260\321\210 \320\267\320\260\320\272\320\260\320\267 ({cart.length})\n          </h2>\n\n          <div className=\"space-y-3 max-h-60 overflow-y-auto pr-1\">\n            {cart.map(item => (\n              <div key={item.product.id} className=\"flex justify-between text-xs\">\n                <div>\n                  <span className=\"font-bold text-slate-900 block truncate max-w-[180px]\">\n                    {item.product.name}\n                  </span>\n                  <span className=\"text-[10px] text-slate-400\">\n                    {item.quantity} x {formatPrice(item.product.priceBYN)}\n                  </span>\n                </div>\n                <span className=\"font-bold text-slate-900\">\n                  {formatPrice(item.product.priceBYN * item.quantity)}\n                </span>\n              </div>\n            ))}\n          </div>\n\n          <div className=\"pt-4 border-t border-slate-200 space-y-2 text-xs\">\n            <div className=\"flex justify-between text-slate-600\">\n              <span>\320\241\321\203\320\274\320\274\320\260 \321\201 \320\235\320\224\320\241 20%:</span>\n              <span className=\"text-lg font-black text-orange-600\">{formatPrice(cartTotalBYN)}</span>\n            </div>\n            <p className=\"text-[10px] text-slate-400\">\n              * \320\224\320\276\321\201\321\202\320\260\320\262\320\272\320\260 \320\277\320\276 \320\221\320\265\320\273\320\260\321\200\321\203\321\201\320\270 \320\261\320\265\321\201\320\277\320\273\320\260\321\202\320\275\320\260 \320\277\321\200\320\270 \320\267\320\260\320\272\320\260\320\267\320\265 \320\276\321\202 500 BYN\n            </p>\n          </div>\n\n          <button\n            type=\"submit\"\n            className=\"w-full py-4 bg-orange-600 hover:bg-orange-700 text-white font-black rounded-2xl text-xs shadow-lg shadow-orange-500/25 transition-all flex items-center justify-center gap-2\"\n          >\n            <FileText className=\"w-4 h-4\" /> \320\241\321\204\320\276\321\200\320\274\320\270\321\200\320\276\320\262\320\260\321\202\321\214 \320\270 \320\276\321\202\320\277\321\200\320\260\320\262\320\270\321\202\321\214 \321\201\321\207\321\221\321\202\n          </button>\n        </div>\n      </form>\n    </div>\n  );\n};\n"
