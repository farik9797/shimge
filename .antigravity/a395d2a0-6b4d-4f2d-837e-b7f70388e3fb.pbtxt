  file_change {
    absolute_path_uri: "file:///src/components/compare/ComparePage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { ArrowLeftRight, Trash2, ShoppingCart, Check, X } from \'lucide-react\';\n\nexport const ComparePage: React.FC = () => {\n  const { compareList, products, toggleCompare, addToCart, formatPrice, setRoute } = useApp();\n\n  const comparedProducts = products.filter(p => compareList.includes(p.id));\n\n  // Collect all unique specification keys across compared products\n  const allSpecNames = Array.from(\n    new Set(\n      comparedProducts.flatMap(p => p.specs.map(s => s.name))\n    )\n  );\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 py-8 animate-fade-in space-y-8\">\n      <div className=\"flex items-center justify-between border-b border-slate-200 pb-4\">\n        <div>\n          <h1 className=\"text-2xl font-black text-slate-900 flex items-center gap-2\">\n            <ArrowLeftRight className=\"w-6 h-6 text-orange-600\" /> \320\241\321\200\320\260\320\262\320\275\320\265\320\275\320\270\320\265 \321\205\320\260\321\200\320\260\320\272\321\202\320\265\321\200\320\270\321\201\321\202\320\270\320\272\n          </h1>\n          <p className=\"text-xs text-slate-500 mt-1\">\n            \320\241\321\200\320\260\320\262\320\275\320\265\320\275\320\270\320\265 \320\277\320\260\321\200\320\260\320\274\320\265\321\202\321\200\320\276\320\262 \320\262\321\213\320\261\321\200\320\260\320\275\320\275\320\276\320\263\320\276 \320\277\321\200\320\276\321\204\320\265\321\201\321\201\320\270\320\276\320\275\320\260\320\273\321\214\320\275\320\276\320\263\320\276 \320\276\320\261\320\276\321\200\321\203\320\264\320\276\320\262\320\260\320\275\320\270\321\217 mzvuk.by\n          </p>\n        </div>\n\n        {comparedProducts.length > 0 && (\n          <button\n            onClick={() => comparedProducts.forEach(p => toggleCompare(p.id))}\n            className=\"text-xs font-bold text-rose-600 hover:underline flex items-center gap-1\"\n          >\n            <Trash2 className=\"w-4 h-4\" /> \320\236\321\207\320\270\321\201\321\202\320\270\321\202\321\214 \321\201\320\277\320\270\321\201\320\276\320\272\n          </button>\n        )}\n      </div>\n\n      {comparedProducts.length === 0 ? (\n        <div className=\"bg-white rounded-3xl p-12 text-center border border-slate-200 space-y-4 max-w-lg mx-auto\">\n          <div className=\"p-4 bg-orange-50 text-orange-600 rounded-full w-fit mx-auto\">\n            <ArrowLeftRight className=\"w-8 h-8\" />\n          </div>\n          <h2 className=\"text-lg font-bold text-slate-800\">\320\235\320\265\321\202 \321\202\320\276\320\262\320\260\321\200\320\276\320\262 \320\264\320\273\321\217 \321\201\321\200\320\260\320\262\320\275\320\265\320\275\320\270\321\217</h2>\n          <p className=\"text-xs text-slate-500\">\n            \320\224\320\276\320\261\320\260\320\262\320\273\321\217\320\271\321\202\320\265 \320\264\320\276 4 \321\202\320\276\320\262\320\260\321\200\320\276\320\262 \320\262 \321\201\320\277\320\270\321\201\320\276\320\272 \321\201\321\200\320\260\320\262\320\275\320\265\320\275\320\270\321\217 \320\270\320\267 \320\272\320\260\321\202\320\260\320\273\320\276\320\263\320\260 \320\264\320\273\321\217 \321\201\320\276\320\277\320\276\321\201\321\202\320\260\320\262\320\273\320\265\320\275\320\270\321\217 \321\202\320\265\321\205\320\275\320\270\321\207\320\265\321\201\320\272\320\270\321\205 \321\205\320\260\321\200\320\260\320\272\321\202\320\265\321\200\320\270\321\201\321\202\320\270\320\272.\n          </p>\n          <button\n            onClick={() => setRoute(\'catalog\')}\n            className=\"px-6 py-2.5 bg-orange-600 text-white font-bold rounded-xl text-xs shadow\"\n          >\n            \320\237\320\265\321\200\320\265\320\271\321\202\320\270 \320\262 \320\272\320\260\321\202\320\260\320\273\320\276\320\263\n          </button>\n        </div>\n      ) : (\n        <div className=\"overflow-x-auto bg-white rounded-3xl border border-slate-200 p-6 shadow-sm\">\n          <table className=\"w-full min-w-[600px] text-xs text-left border-collapse\">\n            <thead>\n              <tr className=\"border-b border-slate-200\">\n                <th className=\"p-4 w-48 text-slate-400 font-bold uppercase text-[10px]\">\n                  \320\237\320\260\321\200\320\260\320\274\320\265\321\202\321\200 / \320\242\320\276\320\262\320\260\321\200\n                </th>\n                {comparedProducts.map(product => (\n                  <th key={product.id} className=\"p-4 w-64 align-top\">\n                    <div className=\"space-y-3 relative\">\n                      <button\n                        onClick={() => toggleCompare(product.id)}\n                        className=\"absolute top-0 right-0 p-1 text-slate-400 hover:text-rose-600\"\n                        title=\"\320\243\320\264\320\260\320\273\320\270\321\202\321\214 \320\270\320\267 \321\201\321\200\320\260\320\262\320\275\320\265\320\275\320\270\321\217\"\n                      >\n                        <X className=\"w-4 h-4\" />\n                      </button>\n\n                      <div className=\"h-32 flex items-center justify-center p-2 bg-slate-50 rounded-2xl border border-slate-100\">\n                        <img\n                          src={product.image}\n                          alt={product.name}\n                          className=\"max-h-full max-w-full object-contain\"\n                        />\n                      </div>\n\n                      <div>\n                        <span className=\"text-[10px] font-bold text-orange-600 uppercase\">\n                          {product.brand}\n                        </span>\n                        <h3 className=\"text-xs font-bold text-slate-900 line-clamp-2 mt-0.5\">\n                          {product.name}\n                        </h3>\n                        <span className=\"text-sm font-black text-slate-900 block mt-1\">\n                          {formatPrice(product.priceBYN)}\n                        </span>\n                      </div>\n\n                      <button\n                        onClick={() => addToCart(product)}\n                        className=\"w-full py-2 bg-orange-600 hover:bg-orange-700 text-white font-bold rounded-xl text-[11px] flex items-center justify-center gap-1.5 shadow\"\n                      >\n                        <ShoppingCart className=\"w-3.5 h-3.5\" /> \320\222 \320\272\320\276\321\200\320\267\320\270\320\275\321\203\n                      </button>\n                    </div>\n                  </th>\n                ))}\n              </tr>\n            </thead>\n\n            <tbody className=\"divide-y divide-slate-100\">\n              <tr className=\"bg-slate-50 font-bold\">\n                <td className=\"p-4 text-slate-700\">\320\235\320\260\320\273\320\270\321\207\320\270\320\265 \320\275\320\260 \321\201\320\272\320\273\320\260\320\264\320\265</td>\n                {comparedProducts.map(p => (\n                  <td key={p.id} className=\"p-4\">\n                    {p.inStock ? (\n                      <span className=\"text-emerald-600 flex items-center gap-1\">\n                        <Check className=\"w-4 h-4\" /> \320\222 \320\275\320\260\320\273\320\270\321\207\320\270\320\270 ({p.stockCount} \321\210\321\202.)\n                      </span>\n                    ) : (\n                      <span className=\"text-slate-400\">\320\237\320\276\320\264 \320\267\320\260\320\272\320\260\320\267</span>\n                    )}\n                  </td>\n                ))}\n              </tr>\n\n              <tr className=\"font-bold\">\n                <td className=\"p-4 text-slate-700\">\320\223\320\260\321\200\320\260\320\275\321\202\320\270\321\217 \320\262 \320\234\320\270\320\275\321\201\320\272\320\265</td>\n                {comparedProducts.map(p => (\n                  <td key={p.id} className=\"p-4 font-bold text-slate-900\">\n                    {p.warrantyMonths} \320\274\320\265\321\201.\n                  </td>\n                ))}\n              </tr>\n\n              {/* Dynamic Specs Rows */}\n              {allSpecNames.map((specName, idx) => (\n                <tr key={idx} className={idx % 2 === 0 ? \'bg-slate-50/50\' : \'bg-white\'}>\n                  <td className=\"p-4 font-semibold text-slate-600\">{specName}</td>\n                  {comparedProducts.map(p => {\n                    const foundSpec = p.specs.find(s => s.name === specName);\n                    return (\n                      <td key={p.id} className=\"p-4 font-bold text-slate-900\">\n                        {foundSpec ? foundSpec.value : \'\342\200\224\'}\n                      </td>\n                    );\n                  })}\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
