32\320\260\321\202\320\265\320\263\320\276\321\200\320\270\320\270 \320\276\320\261\320\276\321\200\321\203\320\264\320\276\320\262\320\260\320\275\320\270\321\217\n                    </span>\n                  </div>\n                  <span className=\"text-[10px] font-bold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full\">\n                    {products.length} \321\202\320\276\320\262\320\260\321\200\320\276\320\262 \320\262 \320\275\320\260\320\273\320\270\321\207\320\270\320\270\n                  </span>\n                </div>\n\n                <div className=\"py-3 grid grid-cols-2 gap-2\">\n                  {MOCK_CATEGORIES.map(cat => (\n                    <button\n                      key={cat.id}\n                      onClick={() => handleCategoryClick(cat.id)}\n                      className=\"group flex items-start gap-3 p-2.5 rounded-2xl hover:bg-orange-50/80 transition-all text-left border border-transparent hover:border-orange-200/80\"\n                    >\n                      <div className=\"p-2 rounded-xl bg-slate-100 group-hover:bg-white group-hover:shadow-xs transition-colors shrink-0 mt-0.5\">\n                        {getCategoryIcon(cat.iconName)}\n                      </div>\n                      <div className=\"min-w-0 flex-1\">\n                        <div className=\"flex items-center justify-between gap-1\">\n                          <h4 className=\"text-xs font-bold text-slate-800 group-hover:text-orange-600 truncate transition-colors\">\n                            {cat.name}\n                          </h4>\n                          <span className=\"text-[10px] font-bold text-slate-400 group-hover:text-orange-500 bg-slate-50 group-hover:bg-orange-100/70 px-1.5 py-0.5 rounded-full shrink-0\">\n                            {cat.productCount}\n                          </span>\n                        </div>\n                        <p className=\"text-[11px] text-slate-500 line-clamp-1 mt-0.5 font-normal leading-tight\">\n                          {cat.description}\n                        </p>\n                      </div>\n                    </button>\n                  ))}\n                </div>\n\n                <div className=\"pt-3 px-1 flex items-center justify-between\">\n                  <span className=\"text-[11px] text-slate-400 font-normal\">\n                    \320\236\321\204\320\270\321\206\320\270\320\260\320\273\321\214\320\275\321\213\320\271 \320\264\320\270\321\201\321\202\321\200\320\270\320\261\321\214\321\216\321\202\320\276\321\200 \320\262 \320\221\320\265\320\273\320\260\321\200\321\203\321\201\320\270 (\321\201 \320\235\320\224\320\241 20%)\n                  </span>\n                  <button\n                    onClick={() => {\n                      setFilters(prev => ({ ...prev, category: \'all\' }));\n                      setRoute(\'catalog\');\n                      setIsCatalogDropdownOpen(false);\n                    }}\n                    className=\"px-3 py-1.5 bg-orange-600 hover:bg-orange-700 text-white text-xs font-bold rounded-xl flex items-center gap-1.5 shadow-sm transition-colors\"\n                  >\n                    <span>\320\222\320\265\321\201\321\214 \320\272\320\260\321\202\320\260\320\273\320\276\320\263</span>\n                    <ArrowRight className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              </div>\n            )}\n          </div>"
