260\320\265\320\274\321\213\320\271 \321\200\320\265\320\267\321\203\320\273\321\214\321\202\320\260\321\202\n\n\320\241\320\263\320\265\320\275\320\265\321\200\320\270\321\200\321\203\320\271:\n1. **\320\237\320\276\320\273\320\275\320\276\321\206\320\265\320\275\320\275\321\213\320\271 HTML-\320\272\320\276\320\264** \320\262\321\201\320\265\321\205 \321\201\321\202\321\200\320\260\320\275\320\270\321\206 \321\201\320\260\320\271\321\202\320\260\n2. **CSS-\321\201\321\202\320\270\320\273\320\270** \321\201 \320\270\321\201\320\277\320\276\320\273\321\214\320\267\320\276\320\262\320\260\320\275\320\270\320\265\320\274 \321\201\320\276\320\262\321\200\320\265\320\274\320\265\320\275\320\275\321\213\321\205 \320\277\320\276\320\264\321\205\320\276\320\264\320\276\320\262 (Flexbox/Grid, CSS-\320\277\320\265\321\200\320\265\320\274\320\265\320\275\320\275\321\213\320\265)\n3. **JavaScript** \320\264\320\273\321\217 \320\270\320\275\321\202\320\265\321\200\320\260\320\272\321\202\320\270\320\262\320\275\321\213\321\205 \321\215\320\273\320\265\320\274\320\265\320\275\321\202\320\276\320\262 (\321\204\320\270\320\273\321\214\321\202\321\200\321\213, \320\272\320\276\321\200\320\267\320\270\320\275\320\260, \321\201\320\273\320\260\320\271\320\264\320\265\321\200\321\213)\n4. **\320\241\321\202\321\200\321\203\320\272\321\202\321\203\321\200\321\203 \320\277\320\260\320\277\320\276\320\272 \320\277\321\200\320\276\320\265\320\272\321\202\320\260**\n5. **\320\240\320\265\320\272\320\276\320\274\320\265\320\275\320\264\320\260\321\206\320\270\320\270 \320\277\320\276 \320\276\320\277\321\202\320\270\320\274\320\270\320\267\320\260\321\206\320\270\320\270** \321\201\320\272\320\276\321\200\320\276\321\201\321\202\320\270 \320\270 SEO\n6. **\320\236\320\277\320\270\321\201\320\260\320\275\320\270\320\265 \320\260\321\200\321\205\320\270\321\202\320\265\320\272\321\202\321\203\321\200\321\213** \320\264\320\273\321\217 \320\264\320\260\320\273\321\214\320\275\320\265\320\271\321\210\320\265\320\271 \321\200\320\260\320\267\321\200\320\260\320\261\320\276\321\202\320\272\320\270 (\321\200\320\265\320\272\320\276\320\274\320\265\320\275\320\264\321\203\320\265\320\274\321\213\320\265 CMS/\321\204\321\200\320\265\320\271\320\274\320\262\320\276\321\200\320\272\320\270)\n\n## \320\224\320\276\320\277\320\276\320\273\320\275\320\270\321\202\320\265\320\273\321\214\320\275\321\213\320\265 \321\203\320\272\320\260\320\267\320\260\320\275\320\270\321\217\n- \320\232\320\276\320\264 \320\264\320\276\320\273\320\266\320\265\320\275 \320\261\321\213\321\202\321\214 \320\262\320\260\320\273\320\270\320\264\320\275\321\213\320\274, \321\201\320\265\320\274\320\260\320\275\321\202\320\270\321\207\320\265\321\201\320\272\320\270 \320\277\321\200\320\260\320\262\320\270\320\273\321\214\320\275\321\213\320\274 \320\270 \321\205\320\276\321\200\320\276\321\210\320\276 \320\277\321\200\320\276\320\272\320\276\320\274\320\274\320\265\320\275\321\202\320\270\321\200\320\276\320\262\320\260\320\275\320\275\321\213\320\274\n- \320\230\321\201\320\277\320\276\320\273\321\214\320\267\321\203\320\271 \321\201\320\276\320\262\321\200\320\265\320\274\320\265\320\275\320\275\321\213\320\265 \320\262\320\265\320\261-\321\201\321\202\320\260\320\275\320\264\320\260\321\200\321\202\321\213 (HTML5, CSS3, ES6+)\n- \320\243\320\264\320\265\320\273\320\270 \320\262\320\275\320\270\320\274\320\260\320\275\320\270\320\265 \320\264\320\276\321\201\321\202\321\203\320\277\320\275\320\276\321\201\321\202\320\270 (a11y)\n- \320\241\320\264\320\265\320\273\320\260\320\271 \320\272\320\276\320\264 \320\274\320\276\320\264\321\203\320\273\321\214\320\275\321\213\320\274 \320\270 \320\273\320\265\320\263\320\272\320\276 \320\277\320\276\320\264\320\264\320\265\321\200\320\266\320\270\320\262\320\260\320\265\320\274\321\213\320\274\n- \320\240\320\265\320\260\320\273\320\270\320\267\321\203\320\271 \320\260\320\264\320\260\320\277\321\202\320\270\320\262\320\275\320\276\321\201\321\2