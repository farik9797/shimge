      target_content: "export const HeroSlider: React.FC = () => {\n  const { setRoute, setFilters } = useApp();\n  const [currentSlide, setCurrentSlide] = useState(0);\n\n  useEffect(() => {\n    const timer = setInterval(() => {\n      setCurrentSlide(prev => (prev + 1) % SLIDES.length);\n    }, 6000);\n    return () => clearInterval(timer);\n  }, []);\n\n  const slide = SLIDES[currentSlide];\n\n  return (\n    <section className=\"relative h-[400px] bg-gradient-to-r from-white via-slate-50 to-orange-50/50 text-slate-900 overflow-hidden rounded-3xl my-6 mx-4 max-w-7xl lg:mx-auto shadow-xl border border-slate-200/80\">\n      {/* Background Image Container */}\n      <div className=\"absolute inset-0 z-0\">\n        <img\n          src={slide.bgImage}\n          alt={slide.title}\n          className=\"w-full h-full object-cover object-right md:object-center opacity-25 md:opacity-35 transition-all duration-1000 transform scale-105\"\n        />\n        {/* Soft light gradient overlay ensuring text readability */}\n        <div className=\"absolute inset-0 bg-gradient-to-r from-white via-white/95 md:via-white/80 to-transparent\"></div>\n      </div>\n\n      {/* Slide Content */}\n      <div className=\"relative z-10 h-full flex flex-col justify-center max-w-2xl px-6 sm:px-10 md:px-14 py-6 space-y-4\">\n        <div>\n          <div className=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-orange-100 text-orange-700 border border-orange-200 text-xs font-bold uppercase tracking-wider shadow-xs\">\n            <Sparkles className=\"w-3.5 h-3.5 text-orange-600\" />\n            {slide.badge}\n          </div>\n        </div>\n\n        <h1 className=\"text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight leading-tight text-slate-900\">\n          {slide.title}\n        </h1>\n\n        <p className=\"text-xs sm:text-sm text-slate-600 leading-relaxed max-w-xl\">\n          {slide.desc}\n        </p>\n\n        <div className=\"flex flex-wrap items-center gap-3 pt-2\">\n          <button\n            onClick={() => {\n              if (slide.route === \'catalog\') {\n                setFilters(prev => ({ ...prev, category: \'all\' }));\n              }\n              setRoute(slide.route as any);\n            }}\n            className=\"px-6 py-3.5 bg-gradient-to-r from-orange-500 to-amber-600 hover:from-orange-600 hover:to-amber-700 text-white font-extrabold rounded-2xl shadow-lg shadow-orange-500/25 flex items-center gap-2.5 transition-all transform hover:-translate-y-0.5 active:translate-y-0 text-xs sm:text-sm\"\n          >\n            {slide.ctaText}\n            <ArrowRight className=\"w-4 h-4\" />\n          </button>\n\n          <div className=\"flex items-center gap-2 px-4 py-3 bg-white/90 backdrop-blur border border-slate-200 rounded-2xl text-xs font-bold text-slate-800 shadow-xs\">\n            <Zap className=\"w-4 h-4 text-amber-500 shrink-0\" />\n            <span>{slide.highlight}</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Navigation Controls */}\n      <div className=\"absolute bottom-6 right-6 z-20 flex items-center gap-2 bg-white/80 backdrop-blur-md p-1.5 rounded-2xl border border-slate-200 shadow-md\">\n        <button\n          onClick={() => setCurrentSlide((currentSlide - 1 + SLIDES.length) % SLIDES.length)}\n          className=\"p-2 rounded-xl bg-slate-100 hover:bg-orange-600 text-slate-700 hover:text-white transition-colors\"\n          aria-label=\"\320\237\321\200\320\265\320\264\321\213\320\264\321\203\321\211\320\270\320\271 \321\201\320\273\320\260\320\271\320\264\"\n        >\n          <ChevronLeft className=\"w-4 h-4\" />\n        </button>\n        <span className=\"text-xs font-black text-slate-700 px-2\">\n          0{currentSlide + 1} / 0{SLIDES.length}\n        </span>\n        <button\n          onClick={() => setCurrentSlide((currentSlide + 1) % SLIDES.length)}\n          className=\"p-2 rounded-xl bg-slate-100 hover:bg-orange-600 text-slate-700 hover:text-white transition-colors\"\n          aria-label=\"\320\241\320\273\320\265\320\264\321\203\321\216\321\211\320\270\320\271 \321\201\320\273\320\260\320\271\320\264\"\n        >\n          <ChevronRight className=\"w-4 h-4\" />\n        </button>\n      </div>\n\n      {/* Slide Indicators / Dots */}\n      <div className=\"absolute bottom-6 left-6 sm:left-10 md:left-14 z-20 flex items-center gap-2\">\n        {SLIDES.map((_, idx) => (\n          <button\n            key={idx}\n            onClick={() => setCurrentSlide(idx)}\n            className={`h-2 rounded-full transition-all duration-300 ${\n              currentSlide === idx ? \'w-8 bg-orange-600\' : \'w-2 bg-slate-300 hover:bg-slate-400\'\n            }`}\n            aria-label={`\320\237\320\265\321\200\320\265\320\271\321\202\320\270 \320\272 \321\201\320\273\320\260\320\271\320\264\321\203 ${idx + 1}`}\n          />\n        ))}\n      </div>\n    </section>\n  );\n};"
      replacement_content: "export const HeroSlider: React.FC = () => {\n  const { setRoute, setFilters } = useApp();\n  const [currentSlide, setCurrentSlide] = useState(0);\n\n  useEffect(() => {\n    const timer = setInterval(() => {\n      setCurrentSlide(prev => (prev + 1) % SLIDES.length);\n    }, 6000);\n    return () => clearInterval(timer);\n  }, []);\n\n  const slide = SLIDES[currentSlide];\n\n  return (\n    <section className=\"relative h-[400px] bg-slate-100/90 text-slate-900 overflow-hidden rounded-3xl my-6 mx-4 max-w-7xl lg:mx-auto shadow-lg border border-slate-200/80\">\n      <div className=\"h-full flex flex-col md:flex-row items-stretch\">\n        {/* Left Content Column */}\n        <div className=\"relative z-10 w-full md:w-7/12 lg:w-3/5 p-6 sm:p-8 md:p-10 flex flex-col justify-between bg-gradient-to-r from-white via-white/95 to-white/80\">\n          <div className=\"space-y-3.5\">\n            <div className=\"inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-orange-100 text-orange-700 border border-orange-200 text-xs font-black uppercase tracking-wider shadow-xs\">\n              <Sparkles className=\"w-3.5 h-3.5 text-orange-600\" />\n              <span>{slide.badge}</span>\n            </div>\n\n            <h1 className=\"text-xl sm:text-2xl lg:text-3xl xl:text-4xl font-black tracking-tight leading-tight text-slate-900\">\n              {slide.title}\n            </h1>\n\n            <p className=\"text-xs sm:text-sm text-slate-600 leading-relaxed line-clamp-2 max-w-xl\">\n              {slide.desc}\n            </p>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-3 pt-2\">\n            <button\n              onClick={() => {\n                if (slide.route === \'catalog\') {\n                  setFilters(prev => ({ ...prev, category: \'all\' }));\n                }\n                setRoute(slide.route as any);\n              }}\n              className=\"px-5 py-3 bg-gradient-to-r from-orange-500 to-amber-600 hover:from-orange-600 hover:to-amber-700 text-white font-extrabold rounded-2xl shadow-md shadow-orange-500/25 flex items-center gap-2 transition-all transform hover:-translate-y-0.5 active:translate-y-0 text-xs sm:text-sm\"\n            >\n              <span>{slide.ctaText}</span>\n              <ArrowRight className=\"w-4 h-4\" />\n            </button>\n\n            <div className=\"flex items-center gap-2 px-3.5 py-2.5 bg-slate-50 border border-slate-200/90 rounded-2xl text-xs font-bold text-slate-800 shadow-xs\">\n              <Zap className=\"w-4 h-4 text-amber-500 shrink-0\" />\n              <span>{slide.highlight}</span>\n            </div>\n          </div>\n\n          {/* Dots & Nav controls */}\n          <div className=\"flex items-center justify-between pt-2 border-t border-slate-100\">\n            <div className=\"flex items-center gap-2\">\n              {SLIDES.map((_, idx) => (\n                <button\n                  key={idx}\n                  onClick={() => setCurrentSlide(idx)}\n                  className={`h-2 rounded-full transition-all duration-300 ${\n                    currentSlide === idx ? \'w-8 bg-orange-600\' : \'w-2 bg-slate-300 hover:bg-slate-400\'\n                  }`}\n                  aria-label={`\320\237\320\265\321\200\320\265\320\271\321\202\320\270 \320\272 \321\201\320\273\320\260\320\271\320\264\321\203 ${idx + 1}`}\n                />\n              ))}\n            </div>\n\n            <div className=\"flex items-center gap-1.5 bg-slate-100 p-1 rounded-xl border border-slate-200\">\n              <button\n                onClick={() => setCurrentSlide((currentSlide - 1 + SLIDES.length) % SLIDES.length)}\n                className=\"p-1.5 rounded-lg hover:bg-orange-600 text-slate-700 hover:text-white transition-colors\"\n                aria-label=\"\320\237\321\200\320\265\320\264\321\213\320\264\321\203\321\211\320\270\320\271 \321\201\320\273\320\260\320\271\320\264\"\n              >\n                <ChevronLeft className=\"w-4 h-4\" />\n              </button>\n              <span className=\"text-[11px] font-black text-slate-700 px-1\">\n                0{currentSlide + 1} / 0{SLIDES.length}\n              </span>\n              <button\n                onClick={() => setCurrentSlide((currentSlide + 1) % SLIDES.length)}\n                className=\"p-1.5 rounded-lg hover:bg-orange-600 text-slate-700 hover:text-white transition-colors\"\n                aria-label=\"\320\241\320\273\320\265\320\264\321\203\321\216\321\211\320\270\320\271 \321\201\320\273\320\260\320\271\320\264\"\n              >\n                <ChevronRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* Right Image Column - 100% Bright, Crisp & Clear */}\n        <div className=\"relative w-full md:w-5/12 lg:w-2/5 h-48 md:h-full overflow-hidden bg-slate-900\">\n          <img\n            key={slide.id}\n            src={slide.bgImage}\n            alt={slide.title}\n            referrerPolicy=\"no-referrer\"\n            className=\"w-full h-full object-cover object-center transition-all duration-700 transform scale-100 hover:scale-105\"\n          />\n          <div className=\"absolute inset-0 bg-gradient-to-t md:bg-gradient-to-r from-black/30 via-transparent to-transparent pointer-events-none\"></div>\n\n          {/* Floating badge over image */}\n          <div className=\"absolute top-4 right-4 bg-white/90 backdrop-blur-md px-3 py-1.5 rounded-xl border border-white/60 shadow-lg text-[11px] font-black text-slate-900 flex items-center gap-1.5\">\n            <Volume2 className=\"w-3.5 h-3.5 text-orange-600\" />\n            <span>mzvuk.by</span>\n          </div>\n\n          <div className=\"absolute bottom-4 left-4 right-4 md:left-4 md:right-auto bg-slate-950/80 backdrop-blur-md px-3.5 py-2 rounded-xl border border-slate-700/60 text-white text-xs font-semibold shadow-lg flex items-center gap-2\">\n            <ShieldCheck className=\"w-4 h-4 text-emerald-400 shrink-0\" />\n            <span className=\"truncate\">\320\223\320\260\321\200\320\260\320\275\321\202\320\270\321\217 \320\270 \321\201\320\265\321\200\320\262\320\270\321\201 \320\262 \320\240\320\221</span>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};"
