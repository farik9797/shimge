    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { MOCK_SERVICES } from \'../../data/mockData\';\nimport { Compass, Wrench, ShieldCheck, Calendar, ArrowRight, CheckCircle2 } from \'lucide-react\';\n\nconst SERVICE_ICONS: Record<string, React.ReactNode> = {\n  Compass: <Compass className=\"w-6 h-6\" />,\n  Wrench: <Wrench className=\"w-6 h-6\" />,\n  ShieldCheck: <ShieldCheck className=\"w-6 h-6\" />,\n  Calendar: <Calendar className=\"w-6 h-6\" />\n};\n\nexport const ServicesSection: React.FC = () => {\n  const { setRoute, formatPrice, setIsCallbackOpen } = useApp();\n\n  return (\n    <section className=\"bg-slate-900 text-white py-16 px-4 my-12\">\n      <div className=\"max-w-7xl mx-auto\">\n        <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-4 mb-12\">\n          <div>\n            <span className=\"text-xs font-bold text-orange-500 uppercase tracking-widest block mb-1\">\n              \320\237\321\200\320\276\320\265\320\272\321\202\320\275\321\213\320\271 \320\276\321\202\320\264\320\265\320\273 mzvuk.by\n            </span>\n            <h2 className=\"text-3xl font-black text-white tracking-tight\">\n              \320\243\321\201\320\273\321\203\320\263\320\270 \320\270 \321\201\320\270\321\201\321\202\320\265\320\274\320\275\320\260\321\217 \320\270\320\275\321\202\320\265\320\263\321\200\320\260\321\206\320\270\321\217\n            </h2>\n            <p className=\"text-slate-400 text-sm mt-2 max-w-xl\">\n              \320\222\321\213\320\277\320\276\320\273\320\275\321\217\320\265\320\274 \320\277\320\276\320\273\320\275\321\213\320\271 \320\272\320\276\320\274\320\277\320\273\320\265\320\272\321\201 \321\200\320\260\320\261\320\276\321\202 \320\277\320\276 \320\276\321\201\320\275\320\260\321\211\320\265\320\275\320\270\321\216 \320\276\320\261\321\212\320\265\320\272\321\202\320\276\320\262 \320\273\321\216\320\261\320\276\320\263\320\276 \320\274\320\260\321\201\321\210\321\202\320\260\320\261\320\260 \320\277\321\200\320\276\321\204\320\265\321\201\321\201\320\270\320\276\320\275\320\260\320\273\321\214\320\275\321\213\320\274 \320\267\320\262\321\203\320\272\320\276\320\274 \320\277\320\276 \320\221\320\265\320\273\320\260\321\200\321\203\321\201\320\270.\n            </p>\n          </div>\n\n          <button\n            onClick={() => setRoute(\'services\')}\n            className=\"px-6 py-3 bg-orange-600 hover:bg-orange-700 text-white font-bold rounded-xl text-xs inline-flex items-center gap-2 transition-colors shrink-0\"\n          >\n            \320\222\321\201\320\265 \321\203\321\201\320\273\321\203\320\263\320\270 <ArrowRight className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {MOCK_SERVICES.map(srv => (\n            <div\n              key={srv.id}\n              className=\"bg-slate-800/80 rounded-2xl p-6 border border-slate-700/80 hover:border-orange-500 transition-all flex flex-col justify-between group\"\n            >\n              <div>\n                <div className=\"w-12 h-12 rounded-xl bg-orange-500/20 text-orange-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform\">\n                  {SERVICE_ICONS[srv.iconName] || <Wrench className=\"w-6 h-6\" />}\n                </div>\n\n                <h3 className=\"text-base font-bold text-white mb-2 leading-snug\">{srv.title}</h3>\n                <p className=\"text-xs text-slate-300 leading-relaxed mb-4\">{srv.shortDesc}</p>\n\n                <ul className=\"space-y-1.5 mb-6 text-xs text-slate-400\">\n                  {srv.features.slice(0, 2).map((feat, idx) => (\n                    <li key={idx} className=\"flex items-start gap-2\">\n                      <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-400 shrink-0 mt-0.5\" />\n                      <span>{feat}</span>\n                    </li>\n                  ))}\n                </ul>\n              </div>\n\n              <div className=\"pt-4 border-t border-slate-700/60 flex items-center justify-between\">\n                <div>\n                  <span className=\"text-[10px] text-slate-400 block uppercase\">\320\241\321\202\320\276\320\270\320\274\320\276\321\201\321\202\321\214 \320\276\321\202</span>\n                  <span className=\"text-sm font-extrabold text-orange-400\">{formatPrice(srv.priceStartBYN)}</span>\n                </div>\n                <button\n                  onClick={() => setIsCallbackOpen(true)}\n                  className=\"px-3 py-1.5 bg-slate-700 hover:bg-orange-600 text-white font-bold rounded-lg text-xs transition-colors\"\n                >\n                  \320\227\320\260\320\272\320\260\320\267\320\260\321\202\321\214\n                </button>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n};\n"
