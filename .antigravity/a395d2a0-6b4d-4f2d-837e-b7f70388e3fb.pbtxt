        replacement_content: "          <button\n            onClick={() => setRoute(\'services\')}\n            className={`px-4 py-3 hover:text-orange-600 transition-colors border-b-2 font-bold ${\n              route === \'services\' ? \'border-orange-600 text-orange-600 bg-white shadow-xs\' : \'border-transparent text-slate-700\'\n            }`}\n          >\n            \320\243\321\201\320\273\321\203\320\263\320\270\n          </button>\n\n          {/* \320\236 \320\272\320\276\320\274\320\277\320\260\320\275\320\270\320\270 \321\201 \320\262\321\213\320\277\320\260\320\264\320\260\321\216\321\211\320\270\320\274 \320\277\320\276\320\264\320\274\320\265\320\275\321\216 */}\n          <div className=\"relative\" ref={aboutRef}>\n            <button\n              onClick={() => setIsAboutDropdownOpen(!isAboutDropdownOpen)}\n              className={`px-4 py-3 hover:text-orange-600 transition-colors border-b-2 flex items-center gap-1 font-bold ${\n                [\'about\', \'certificates\', \'news\', \'faq\', \'partners\'].includes(route)\n                  ? \'border-orange-600 text-orange-600 bg-white\'\n                  : \'border-transparent text-slate-700\'\n              }`}\n            >\n              <span>\320\236 \320\272\320\276\320\274\320\277\320\260\320\275\320\270\320\270</span>\n              <ChevronDown className={`w-3.5 h-3.5 transition-transform duration-200 ${isAboutDropdownOpen ? \'rotate-180 text-orange-600\' : \'text-slate-400\'}`} />\n            </button>\n\n            {isAboutDropdownOpen && (\n              <div className=\"absolute top-full left-0 mt-0.5 w-60 bg-white border border-slate-200 rounded-2xl shadow-xl py-2 z-50 animate-fade-in divide-y divide-slate-100\">\n                <div className=\"py-1\">\n                  <button\n                    onClick={() => {\n                      setRoute(\'about\');\n                      setIsAboutDropdownOpen(false);\n                    }}\n                    className={`