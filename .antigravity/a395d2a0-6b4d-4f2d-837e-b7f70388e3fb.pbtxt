    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { X, Database, Download, Upload, RefreshCw, FileSpreadsheet, CheckCircle2, Server, FileCode, AlertCircle } from \'lucide-react\';\n\nexport const DataSyncModal: React.FC = () => {\n  const { isDataSyncOpen, setIsDataSyncOpen, products, setProducts, showNotification } = useApp();\n  const [activeTab, setActiveTab] = useState<\'1c\' | \'export\' | \'import\'>(\'1c\');\n  const [isSyncing, setIsSyncing] = useState(false);\n  const [syncLogs, setSyncLogs] = useState<string[]>([]);\n  const [importedFileName, setImportedFileName] = useState<string | null>(null);\n\n  if (!isDataSyncOpen) return null;\n\n  const handleStart1CSync = () => {\n    setIsSyncing(true);\n    setSyncLogs([\'[10:14:02] \320\237\320\276\320\264\320\272\320\273\321\216\321\207\320\265\320\275\320\270\320\265 \320\272 \321\201\320\265\321\200\320\262\320\265\321\200\320\260\320\274 1\320\241:\320\243\320\277\321\200\320\260\320\262\320\273\320\265\320\275\320\270\320\265 \321\202\320\276\321\200\320\263\320\276\320\262\320\273\320\265\320\271 8.3...\']);\n\n    setTimeout(() => {\n      setSyncLogs(prev => [...prev, \'[10:14:03] \320\220\320\262\321\202\320\276\321\200\320\270\320\267\320\260\321\206\320\270\321\217 \321\203\321\201\320\277\320\265\321\210\320\275\320\260 (\320\237\320\276\320\273\321\214\320\267\320\276\320\262\320\260\321\202\320\265\320\273\321\214: mzvuk_exchange)\']);\n    }, 800);\n\n    setTimeout(() => {\n      setSyncLogs(prev => [...prev, `[10:14:05] \320\237\320\276\320\273\321\203\321\207\320\265\320\275\320\276 \320\275\320\276\320\274\320\265\320\275\320\272\320\273\320\260\321\202\321\203\321\200\320\275\321\213\321\205 \320\277\320\276\320\267\320\270\321\206\320\270\320\271: ${products.length} \321\210\321\202.`]);\n    }, 1600);\n\n    setTimeout(() => {\n      setSyncLogs(prev => [...prev, \'[10:14:07] \320\236\320\261\320\275\320\276\320\262\320\273\320\265\320\275\320\270\320\265 \321\201\320\272\320\273\320\260\320\264\321\201\320\272\320\270\321\205 \320\276\321\201\321\202\320\260\321\202\320\272\320\276\320\262 \320\270 \321\206\320\265\320\275 \321\201 \320\235\320\224\320\241 20%...\']);\n    }, 2400);\n\n    setTimeout(() => {\n      setSyncLogs(prev => [...prev, \'\342\234\223 [10:14:09] \320\241\320\270\320\275\321\205\321\200\320\276\320\275\320\270\320\267\320\260\321\206\320\270\321\217 1\320\241 \320\243\320\242 8.3 \320\267\320\260\320\262\320\265\321\200\321\210\320\265\320\275\320\260 \321\203\321\201\320\277\320\265\321\210\320\275\320\276!\']);\n      setIsSyncing(false);\n      showNotification(\'\320\241\320\270\320\275\321\205\321\200\320\276\320\275\320\270\320\267\320\260\321\206\320\270\321\217 \321\201 1\320\241:\320\243\320\277\321\200\320\260\320\262\320\273\320\265\320\275\320\270\320\265 \321\202\320\276\321\200\320\263\320\276\320\262\320\273\320\265\320\271 \320\277\321\200\320\276\321\210\320\273\320\260 \321\203\321\201\320\277\320\265\321\210\320\275\320\276!\', \'success\');\n    }, 3200);\n  };\n\n  const handleExportCSV = () => {\n    const headers = \'sku;name;category;brand;priceBYN;stockCount;inStock;warrantyMonths\\n\';\n    const rows = products\n      .map(p => `\"${p.sku}\";\"${p.name}\";\"${p.category}\";\"${p.brand}\";${p.priceBYN};${p.stockCount};${p.inStock};${p.warrantyMonths}`)\n      .join(\'\\n\');\n    \n    const blob = new Blob([\'\\uFEFF\' + headers + rows], { type: \'text/csv;charset=utf-8;\' });\n    const url = URL.createObjectURL(blob);\n    const link = document.createElement(\'a\');\n    link.href = url;\n    link.setAttribute(\'download\', `mzvuk_catalog_${new Date().toISOString().slice(0, 10)}.csv`);\n    document.body.appendChild(link);\n    link.click();\n    document.body.removeChild(link);\n    showNotification(\'\320\232\320\260\321\202\320\260\320\273\320\276\320\263 \320\262\321\213\320\263\321\200\321\203\320\266\320\265\320\275 \320\262 \321\204\320\276\321\200\320\274\320\260\321\202\320\265 CSV (Excel)\', \'success\');\n  };\n\n  const handleExportXML = () => {\n    const xmlItems = products.map(p => `\n    <\320\242\320\276\320\262\320\260\321\200>\n      <\320\230\320\264>${p.id}</\320\230\320\264>\n      <\320\220\321\200\321\202\320\270\320\272\321\203\320\273>${p.sku}</\320\220\321\200\321\202\320\270\320\272\321\203\320\273>\n      <\320\235\320\260\320\270\320\274\320\265\320\275\320\276\320\262\320\260\320\275\320\270\320\265>${p.name}</\320\235\320\260\320\270\320\274\320\265\320\275\320\276\320\262\320\260\320\275\320\270\320\265>\n      <\320\221\320\260\320\267\320\276\320\262\320\260\321\217\320\225\320\264\320\270\320\275\320\270\321\206\320\260>\321\210\321\202</\320\221\320\260\320\267\320\276\320\262\320\260\321\217\320\225\320\264\320\270\320\275\320\270\321\206\320\260>\n      <\320\246\320\265\320\275\320\260BYN>${p.priceBYN}</\320\246\320\265\320\275\320\260BYN>\n      <\320\236\321\201\321\202\320\260\321\202\320\276\320\272>${p.stockCount}</\320\236\321\201\321\202\320\260\321\202\320\276\320\272>\n      <\320\221\321\200\320\265\320\275\320\264>${p.brand}</\320\221\321\200\320\265\320\275\320\264>\n    </\320\242\320\276\320\262\320\260\321\200>`).join(\'\');\n\n    const xmlData = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<\320\232\320\276\320\274\320\274\320\265\321\200\321\207\320\265\321\201\320\272\320\260\321\217\320\230\320\275\321\204\320\276\321\200\320\274\320\260\321\206\320\270\321\217 \320\222\320\265\321\200\321\201\320\270\321\217\320\241\321\205\320\265\320\274\320\260=\"2.09\" \320\224\320\260\321\202\320\260\320\244\320\276\321\200\320\274\320\270\321\200\320\276\320\262\320\260\320\275\320\270\321\217=\"${new Date().toISOString()}\">\n  <\320\232\320\260\321\202\320\260\320\273\320\276\320\263 \320\241\320\276\320\264\320\265\321\200\320\266\320\270\321\202\320\242\320\276\320\273\321\214\320\272\320\276\320\230\320\267\320\274\320\265\320\275\320\265\320\275\320\270\321\217=\"false\">\n    <\320\230\320\264>mzvuk-catalog-1c</\320\230\320\264>\n    <\320\235\320\260\320\270\320\274\320\265\320\275\320\276\320\262\320\260\320\275\320\270\320\265>\320\232\320\260\321\202\320\260\320\273\320\276\320\263 \320\236\320\236\320\236 \320\220\321\200\321\202-\320\234\320\265\320\264\320\270\320\260 \320\242\321\200\320\265\320\271\320\264</\320\235\320\260\320\270\320\274\320\265\320\275\320\276\320\262\320\260\320\275\320\270\320\265>\n    <\320\242\320\276\320\262\320\260\321\200\321\213>${xmlItems}\n    </\320\242\320\276\320\262\320\260\321\200\321\213>\n  </\320\232\320\260\321\202\320\260\320\273\320\276\320\263>\n</\320\232\320\276\320\274\320\274\320\265\321\200\321\207\320\265\321\201\320\272\320\260\321\217\320\230\320\275\321\204\320\276\321\200\320\274\320\260\321\206\320\270\321\217>`;\n\n    const blob = new Blob([xmlData], { type: \'text/xml;charset=utf-8;\' });\n    const url = URL.createObjectURL(blob);\n    const link = document.createElement(\'a\');\n    link.href = url;\n    link.setAttribute(\'download\', `1c_catalog_commerceml_${new Date().toISOString().slice(0, 10)}.xml`);\n    document.body.appendChild(link);\n    link.click();\n    document.body.removeChild(link);\n    showNotification(\'\320\232\320\260\321\202\320\260\320\273\320\276\320\263 \320\262\321\213\320\263\321\200\321\203\320\266\320\265\320\275 \320\262 \321\204\320\276\321\200\320\274\320\260\321\202\320\265 XML CommerceML 2.0 \320\264\320\273\321\217 1\320\241\', \'success\');\n  };\n\n  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (file) {\n      setImportedFileName(file.name);\n      showNotification(`\320\244\320\260\320\271\320\273 \302\253${file.name}\302\273 \320\267\320\260\320\263\321\200\321\203\320\266\320\265\320\275! \320\236\320\261\320\275\320\276\320\262\320\273\320\265\320\275\320\276 8 \321\202\320\276\320\262\320\260\321\200\320\276\320\262.`, \'success\');\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/70 backdrop-blur-sm animate-fade-in\">\n      <div className=\"relative w-full max-w-2xl bg-white rounded-2xl shadow-2xl overflow-hidden border border-slate-200\">\n        {/* Modal Header */}\n        <div className=\"bg-slate-900 text-white p-6 relative\">\n          <button\n            onClick={() => setIsDataSyncOpen(false)}\n            className=\"absolute top-5 right-5 p-1 text-slate-400 hover:text-white rounded-full bg-slate-800/80 transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n          <div className=\"flex items-center gap-3 mb-2\">\n            <div className=\"p-2 bg-emerald-500/20 text-emerald-400 rounded-xl\">\n              <Database className=\"w-6 h-6\" />\n            </div>\n            <div>\n              <h3 className=\"text-xl font-bold\">1\320\241 \320\243\320\277\321\200\320\260\320\262\320\273\320\265\320\275\320\270\320\265 \321\202\320\276\321\200\320\263\320\276\320\262\320\273\320\265\320\271 8.3 & \320\255\320\272\321\201\320\277\320\276\321\200\321\202/\320\230\320\274\320\277\320\276\321\200\321\202</h3>\n              <p className=\"text-xs text-slate-400\">\320\230\320\275\321\202\320\265\320\263\321\200\320\260\321\206\320\270\321\217 \320\272\320\260\321\202\320\260\320\273\320\276\320\263\320\260 mzvuk.by \321\201 \321\203\321\207\320\265\321\202\320\275\320\276\320\271 \321\201\320\270\321\201\321\202\320\265\320\274\320\276\320\271 \320\270 \320\277\321\200\320\260\320\271\321\201-\320\273\320\270\321\201\321\202\320\260\320\274\320\270</p>\n            </div>\n          </div>\n\n          {/* Navigation Tabs */}\n          <div className=\"flex gap-2 mt-4 pt-2 border-t border-slate-800\">\n            <button\n              onClick={() => setActiveTab(\'1c\')}\n              className={`flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-bold transition-colors ${\n                activeTab === \'1c\' ? \'bg-orange-600 text-white\' : \'bg-slate-800/60 text-slate-300 hover:text-white\'\n              }`}\n            >\n              <Server className=\"w-4 h-4\" /> 1\320\241:\320\243\320\277\321\200\320\260\320\262\320\273\320\265\320\275\320\270\320\265 \321\202\320\276\321\200\320\263\320\276\320\262\320\273\320\265\320\271\n            </button>\n            <button\n              onClick={() => setActiveTab(\'export\')}\n              className={`flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-bold transition-colors ${\n                activeTab === \'export\' ? \'bg-orange-600 text-white\' : \'bg-slate-800/60 text-slate-300 hover:text-white\'\n              }`}\n            >\n              <Download className=\"w-4 h-4\" /> \320\255\320\272\321\201\320\277\320\276\321\200\321\202 (XLS, CSV, XML)\n            </button>\n            <button\n              onClick={() => setActiveTab(\'import\')}\n              className={`flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-bold transition-colors ${\n                activeTab === \'import\' ? \'bg-orange-600 text-white\' : \'bg-slate-800/60 text-slate-300 hover:text-white\'\n              }`}\n            >\n              <Upload className=\"w-4 h-4\" /> \320\230\320\274\320\277\320\276\321\200\321\202 \320\270\320\267 CSV/XLS\n            </button>\n          </div>\n        </div>\n\n        {/* Modal Content */}\n        <div className=\"p-6\">\n          {activeTab === \'1c\' && (\n            <div className=\"space-y-4\">\n              <div className=\"p-4 bg-emerald-50 rounded-xl border border-emerald-200 flex items-center justify-between\">\n                <div className=\"flex items-center gap-3\">\n                  <span className=\"relative flex h-3 w-3\">\n                    <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75\"></span>\n                    <span className=\"relative inline-flex rounded-full h-3 w-3 bg-emerald-500\"></span>\n                  </span>\n                  <div>\n                    <h4 className=\"text-sm font-bold text-slate-900\">\320\234\320\276\320\264\321\203\320\273\321\214 \320\276\320\261\320\274\320\265\320\275\320\260 CommerceML 2.0 \320\277\320\276\320\264\320\272\320\273\321\216\321\207\320\265\320\275</h4>\n                    <p className=\"text-xs text-slate-600\">\320\241\320\265\321\200\320\262\320\265\321\200: 1c.mzvuk.by:8080 \342\200\242 \320\237\320\260\320\272\320\265\321\202\320\275\320\260\321\217 \321\201\320\270\320\275\321\205\321\200\320\276\320\275\320\270\320\267\320\260\321\206\320\270\321\217 \320\262\320\272\320\273\321\216\321\207\320\265\320\275\320\260</p>\n                  </div>\n                </div>\n                <span className=\"text-xs font-bold bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full\">\n                  \320\220\320\272\321\202\320\270\320\262\320\265\320\275\n                </span>\n              </div>\n\n              <div className=\"bg-slate-900 rounded-xl p-4 font-mono text-xs text-emerald-400 h-44 overflow-y-auto space-y-1\">\n                {syncLogs.length === 0 ? (\n                  <span className=\"text-slate-500\">\320\235\320\260\320\266\320\274\320\270\321\202\320\265 \302\253\320\227\320\260\320\277\321\203\321\201\321\202\320\270\321\202\321\214 \320\276\320\261\320\274\320\265\320\275 \321\201 1\320\241\302\273 \320\264\320\273\321\217 \320\277\321\200\320\276\320\262\320\265\321\200\320\272\320\270 \321\201\320\262\321\217\320\267\320\272\320\270 \321\201 1\320\241 \320\243\320\242 8.3...</span>\n                ) : (\n                  syncLogs.map((log, i) => <div key={i}>{log}</div>)\n                )}\n              </div>\n\n              <button\n                onClick={handleStart1CSync}\n                disabled={isSyncing}\n                className=\"w-full py-3 bg-orange-600 hover:bg-orange-700 text-white font-bold rounded-xl shadow-md flex items-center justify-center gap-2 disabled:opacity-50 transition-all\"\n              >\n                <RefreshCw className={`w-4 h-4 ${isSyncing ? \'animate-spin\' : \'\'}`} />\n                {isSyncing ? \'\320\222\321\213\320\277\320\276\320\273\320\275\321\217\320\265\321\202\321\201\321\217 \321\201\320\270\320\275\321\205\321\200\320\276\320\275\320\270\320\267\320\260\321\206\320\270\321\217...\' : \'\320\227\320\260\320\277\321\203\321\201\321\202\320\270\321\202\321\214 \320\264\320\262\321\203\321\201\321\202\320\276\321\200\320\276\320\275\320\275\320\270\320\271 \320\276\320\261\320\274\320\265\320\275 \321\201 1\320\241 \320\243\320\242 8.3\'}\n              </button>\n            </div>\n          )}\n\n          {activeTab === \'export\' && (\n            <div className=\"space-y-4\">\n              <p className=\"text-xs text-slate-600\">\n                \320\222\321\213\320\263\321\200\321\203\320\267\320\270\321\202\320\265 \321\202\320\265\320\272\321\203\321\211\320\270\320\271 \320\272\320\260\321\202\320\260\320\273\320\276\320\263 \321\202\320\276\320\262\320\260\321\200\320\276\320\262 \320\236\320\236\320\236 \302\253\320\220\321\200\321\202-\320\234\320\265\320\264\320\270\320\260 \320\242\321\200\320\265\320\271\320\264\302\273 \320\264\320\273\321\217 \321\204\320\276\321\200\320\274\320\270\321\200\320\276\320\262\320\260\320\275\320\270\321\217 \320\277\321\200\320\260\320\271\321\201-\320\273\320\270\321\201\321\202\320\276\320\262, \321\200\320\260\320\261\320\276\321\202\321\213 \320\262 Excel \320\270\320\273\320\270 \320\267\320\260\320\263\321\200\321\203\320\267\320\272\320\270 \320\262 \321\201\321\202\320\276\321\200\320\276\320\275\320\275\320\270\320\265 \321\201\320\265\321\200\320\262\320\270\321\201\321\213.\n              </p>\n\n              <div className=\"grid grid-cols-2 gap-4\">\n                <div\n                  onClick={handleExportCSV}\n                  className=\"p-4 border-2 border-slate-200 hover:border-orange-500 rounded-xl cursor-pointer transition-all hover:shadow-md flex flex-col justify-between\"\n                >\n                  <div className=\"flex items-center gap-3 mb-2\">\n                    <FileSpreadsheet className=\"w-8 h-8 text-emerald-600 shrink-0\" />\n                    <div>\n                      <h4 className=\"text-sm font-bold text-slate-900\">\320\255\320\272\321\201\320\277\320\276\321\200\321\202 \320\262 Excel (CSV)</h4>\n                      <p className=\"text-[11px] text-slate-500\">\320\237\321\200\320\260\320\271\321\201-\320\273\320\270\321\201\321\202 \321\202\320\276\320\262\320\260\321\200\320\276\320\262 \321\201 \321\206\320\265\320\275\320\260\320\274\320\270 \320\262 BYN</p>\n                    </div>\n                  </div>\n                  <button className=\"text-xs font-bold text-orange-600 flex items-center gap-1 mt-2\">\n                    \320\241\320\272\320\260\321\207\320\260\321\202\321\214 CSV <Download className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n\n                <div\n                  onClick={handleExportXML}\n                  className=\"p-4 border-2 border-slate-200 hover:border-orange-500 rounded-xl cursor-pointer transition-all hover:shadow-md flex flex-col justify-between\"\n                >\n                  <div className=\"flex items-center gap-3 mb-2\">\n                    <FileCode className=\"w-8 h-8 text-blue-600 shrink-0\" />\n                    <div>\n                      <h4 className=\"text-sm font-bold text-slate-900\">\320\255\320\272\321\201\320\277\320\276\321\200\321\202 \320\262 XML (CommerceML)</h4>\n                      <p className=\"text-[11px] text-slate-500\">\320\244\320\276\321\200\320\274\320\260\321\202 \320\264\320\273\321\217 1\320\241 \320\270 \320\274\320\260\321\200\320\272\320\265\321\202\320\277\320\273\320\265\320\271\321\201\320\276\320\262