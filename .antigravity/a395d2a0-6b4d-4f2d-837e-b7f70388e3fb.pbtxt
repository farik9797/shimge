    instruction: "Update desktop nav bar container and dropdown layout to ensure submenus are visible and smoothly interactive on hover and click"
    replacement_infos {
      original_chunk {
        target_content: "      {/* Main Nav Menu Bar (Desktop) */}\n      <nav className=\"hidden lg:block bg-slate-100 border-t border-slate-200\">\n        <div className=\"max-w-7xl mx-auto px-4 flex items-center gap-1 overflow-x-auto text-xs font-bold text-slate-700\">\n          <button\n            onClick={() => setRoute(\'home\')}\n            className={`px-4 py-3 hover:text-orange-600 transition-colors border-b-2 ${\n              route === \'home\' ? \'border-orange-600 text-orange-600 bg-white\' : \'border-transparent\'\n            }`}\n          >\n            \320\223\320\273\320\260\320\262\320\275\320\260\321\217\n          </button>\n\n          {/* \320\232\320\260\321\202\320\260\320\273\320\276\320\263 \321\201 \320\262\321\213\320\277\320\260\320\264\320\260\321\216\321\211\320\270\320\274 \320\274\320\265\320\275\321\216 \320\262\321\201\320\265\321\205 \320\272\320\260\321\202\320\265\320\263\320\276\321\200\320\270\320\271 \320\277\321\200\320\270 \320\275\320\260\320\262\320\265\320\264\320\265\320\275\320\270\320\270 */}\n          <div \n            className=\"relative\" \n            ref={catalogRef}\n            onMouseEnter={handleCatalogMouseEnter}\n            onMouseLeave={handleCatalogMouseLeave}\n          >\n            <button\n              onClick={() => setRoute(\'catalog\')}\n              className={`px-4 py-3 hover:text-orange-600 transition-colors border-b-2 font-bold flex items-center gap-1.5 ${\n                route === \'catalog\' ? \'border-orange-600 text-orange-600 bg-white shadow-xs\' : \'border-transparent text-slate-700\'\n              }`}\n            >\n              <span>\320\232\320\260\321\202\320\260\320\273\320\276\320\263</span>\n              <ChevronDown className={`w-3.5 h-3.5 transition-transform duration-200 ${isCatalogDropdownOpen ? \'rotate-180 text-orange-600\' : \'text-slate-400\'}`} />\n            </button>\n\n            {isCatalogDropdownOpen && (\n              <div \n                className=\"absolute top-full left-0 mt-0.5 w-[560px] bg-white border border-slate-200 rounded-3xl shadow-2xl p-4 z-50 animate-fade-in divide-y divide-slate-100\"\n                onMouseEnter={handleCatalogMouseEnter}\n                onMouseLeave={handleCatalogMouseLeave}\n              >\n                <div className=\"pb-3 px-2 flex items-center justify-between\">\n                  <div className=\"flex items-center gap-2\">\n                    <Sliders className=\"w-4 h-4 text-orange-600\" />\n                    <span className=\"text-xs font-black uppercase tracking-wider text-slate-900\">\n                      \320\232\320\260\321\202\320\265\320\263\320\276\321\200\320\270\320\270 \320\276\320\261\320\276\321\200\321\203\320\264\320\276\320\262\320\260\320\275\320\270\321\217\n                    </span>\n                  </div>\n                  <span className=\"text-[10px] font-bold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full\">\n                    {products.length} \321\202\320\276\320\262\320\260\321\200\320\276\320\262 \320\262 \320\275\320\260\320\273\320\270\321\207\320\270\320\270\n                  </span>\n                </div>\n\n                <div className=\"py-3 grid grid-cols-2 gap-2\">\n                  {MOCK_CATEGORIES.map(cat => (\n                    <button\n                      key={cat.id}\n                      onClick={() => handleCategoryClick(cat.id)}\n                      className=\"group flex items-start gap-3 p-2.5 rounded-2xl hover:bg-orange-50/80 transition-all text-left border border-transparent hover:border-orange-200/80\"\n                    >\n                      <div className=\"p-2 rounded-xl bg-slate-100 group-hover:bg-white group-hover:shadow-xs transition-colors shrink-0 mt-0.5\">\n                        {getCategoryIcon(cat.iconName)}\n                      </div>\n                      <div className=\"min-w-0 flex-1\">\n                        <div className=\"flex items-center justify-between gap-1\">\n                          <h4 className=\"text-xs font-bold text-slate-800 group-hover:text-orange-600 truncate transition-colors\">\n                            {cat.name}\n                          </h4>\n                          <span className=\"text-[10px] font-bold text-slate-400 group-hover:text-orange-500 bg-slate-50 group-hover:bg-orange-100/70 px-1.5 py-0.5 rounded-full shrink-0\">\n                            {cat.productCount}\n                          </span>\n                        </div>\n                        <p className=\"text-[11px] text-slate-500 line-clamp-1 mt-0.5 font-normal leading-tight\">\n                          {cat.description}\n                        </p>\n                      </div>\n                    </button>\n                  ))}\n                </div>\n\n                <div className=\"pt-3 px-1 flex items-center justify-between\">\n                  <span className=\"text-[11px] text-slate-400 font-normal\">\n                    \320\236\321\204\320\270\321\206\320\270\320\260\320\273\321\214\320\275\321\213\320\271 \320\264\320\270\321\201\321\202\321\200\320\270\320\261\321\214\321\216\321\202\320\276\321\200 \320\262 \320\221\320\265\320\273\320\260\321\200\321\203\321\201\320\270 (\321\201 \320\235\320\224\320\241 20%)\n                  </span>\n                  <button\n                    onClick={() => {\n                      setFilters(prev => ({ ...prev, category: \'all\' }));\n                      setRoute(\'catalog\');\n                      setIsCatalogDropdownOpen(false);\n                    }}\n                    className=\"px-3 py-1.5 bg-orange-600 hover:bg-orange-700 text-white text-xs font-bold rounded-xl flex items-center gap-1.5 shadow-sm transition-colors\"\n                  >\n                    <span>\320\222\320\265\321\201\321\214 \320\272\320\260\321\202\320\260\320\273\320\276\320\263</span>\n                    <ArrowRight className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              </div>\n            )}\n          </div>\n\n          <button\n            onClick={() => setRoute(\'services\')}\n            className={`px-4 py-3 hover:text-orange-600 transition-colors border-b-2 font-bold ${\n              route === \'services\' ? \'border-orange-600 text-orange-600 bg-white shadow-xs\' : \'border-transparent text-slate-700\'\n            }`}\n          >\n            \320\243\321\201\320\273\321\203\320\263\320\270\n          </button>\n\n          {/* \320\236 \320\272\320\276\320\274\320\277\320\260\320\275\320\270\320\270 \321\201 \320\262\321\213\320\277\320\260\320\264\320\260\321\216\321\211\320\270\320\274 \320\277\320\276\320\264\320\274\320\265\320\275\321\216 */}\n          <div className=\"relative\" ref={aboutRef}>\n            <button\n              onClick={() => setIsAboutDropdownOpen(!isAboutDropdownOpen)}\n              className={`px-4 py-3 hover:text-orange-600 transition-colors border-b-2 flex items-center gap-1 font-bold ${\n                [\'about\', \'certificates\', \'news\', \'faq\', \'partners\'].includes(route)\n                  ? \'border-orange-600 text-orange-600 bg-white\'\n                  : \'border-transparent text-slate-700\'\n              }`}\n            >\n              <span>\320\236 \320\272\320\276\320\274\320\277\320\260\320\275\320\270\320\270</span>\n              <ChevronDown className={`w-3.5 h-3.5 transition-transform duration-200 ${isAboutDropdownOpen ? \'rotate-180 text-orange-600\' : \'text-slate-400\'}`} />\n            </button>\n\n            {isAboutDropdownOpen && (\n              <div className=\"absolute top-full left-0 mt-0.5 w-60 bg-white border border-slate-200 rounded-2xl shadow-xl py-2 z-50 animate-fade-in divide-y divide-slate-100\">\n                <div className=\"py-1\">\n                  <button\n                    onClick={() => {\n                      setRoute(\'about\');\n                      setIsAboutDropdownOpen(false);\n                    }}\n                    className={`w-full text-left px-4 py-2.5 hover:bg-orange-50 hover:text-orange-600 transition-colors flex items-center justify-between text-xs ${\n                      route === \'about\' ? \'text-orange-600 font-bold bg-orange-50/60\' : \'text-slate-700\'\n                    }`}\n                  >\n                    <span>\320\236 \320\275\320\260\321\201 \320\270 \320\270\321\201\321\202\320\276\321\200\320\270\321\217</span>\n                    <span className=\"text-[10px] text-slate-400 font-normal\">mzvuk.by</span>\n                  </button>\n                  <button\n                    onClick={() => {\n                      setRoute(\'certificates\');\n                      setIsAboutDropdownOpen(false);\n                    }}\n                    className={`w-full text-left px-4 py-2.5 hover:bg-orange-50 hover:text-orange-600 transition-colors flex items-center justify-between text-xs ${\n                      route === \'certificates\' ? \'text-orange-600 font-bold bg-orange-50/60\' : \'text-slate-700\'\n                    }`}\n                  >\n                    <span>\320\241\320\265\321\200\321\202\320\270\321\204\320\270\320\272\320\260\321\202\321\213 \320\270 \320\264\320\276\320\272\321\203\320\274\320\265\320\275\321\202\321\213</span>\n                    <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-500\" />\n                  </button>\n                  <button\n                    onClick={() => {\n                      setRoute(\'partners\');\n                      setIsAboutDropdownOpen(false);\n                    }}\n                    className={`w-full text-left px-4 py-2.5 hover:bg-orange-50 hover:text-orange-600 transition-colors flex items-center justify-between text-xs ${\n                      route === \'partners\' ? \'text-orange-600 font-bold bg-orange-50/60\' : \'text-slate-700\'\n                    }`}\n                  >\n                    <span>