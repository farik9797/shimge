    response: "\320\237\320\265\321\200\320\265\320\275\321\221\321\201 \321\200\320\260\320\267\320\264\320\265\320\273\321\213 **\320\241\320\265\321\200\321\202\320\270\321\204\320\270\320\272\320\260\321\202\321\213**, **\320\221\321\200\320\265\320\275\320\264\321\213 \320\270 \320\277\320\260\321\200\321\202\320\275\320\265\321\200\321\213**, **\320\235\320\276\320\262\320\276\321\201\321\202\320\270 \320\270 \321\201\321\202\320\260\321\202\321\214\320\270**, \320\260 \321\202\320\260\320\272\320\266\320\265 **\320\222\320\276\320\277\321\200\320\276\321\201-\320\276\321\202\320\262\320\265\321\202 (FAQ)** \320\262 \320\262\321\213\320\277\320\260\320\264\320\260\321\216\321\211\320\265\320\265 \320\277\320\276\320\264\320\274\320\265\320\275\321\216 **\302\253\320\236 \320\272\320\276\320\274\320\277\320\260\320\275\320\270\320\270\302\273**:\n\n- **\320\232\320\276\320\274\320\277\320\260\320\272\321\202\320\275\320\260\321\217 \321\201\321\202\321\200\321\203\320\272\321\202\321\203\321\200\320\260 \321\210\320\260\320\277\320\272\320\270**: \320\236\321\201\320\275\320\276\320\262\320\275\320\260\321\217 \320\275\320\260\320\262\320\270\320\263\320\260\321\206\320\270\321\217 \321\202\320\265\320\277\320\265\321\200\321\214 \320\273\320\260\320\272\320\276\320\275\320\270\321\207\320\275\320\276 \320\276\321\202\320\276\320\261\321\200\320\260\320\266\320\260\320\265\321\202 \320\272\320\273\321\216\321\207\320\265\320\262\321\213\320\265 \321\200\320\260\320\267\320\264\320\265\320\273\321\213 (*\320\223\320\273\320\260\320\262\320\275\320\260\321\217*, *\320\232\320\260\321\202\320\260\320\273\320\276\320\263*, *\320\243\321\201\320\273\321\203\320\263\320\270*, *\320\236 \320\272\320\276\320\274\320\277\320\260\320\275\320\270\320\270* \321\201 \320\262\321\213\320\277\320\260\320\264\320\260\321\216\321\211\320\270\320\274 \320\274\320\265\320\275\321\216, *\320\236\320\277\320\273\320\260\321\202\320\260 \320\270 \320\264\320\276\321\201\321\202\320\