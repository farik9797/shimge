  file_change {
    absolute_path_uri: "file:///src/components/layout/Header.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useRef, useEffect } from \'react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { PageRoute } from \'../../types\';\nimport { \n  Phone, Mail, MapPin, Clock, Search, ShoppingCart, Heart, \n  ArrowLeftRight, Menu, X, ChevronDown, Database, Sliders, Volume2, \n  Sparkles, ShieldCheck, Zap \n} from \'lucide-react\';\nimport { MOCK_CATEGORIES } from \'../../data/mockData\';\n\nexport const Header: React.FC = () => {\n  const { \n    route, \n    setRoute, \n    cartTotalCount, \n    cartTotalBYN, \n    wishlist, \n    compareList, \n    currency, \n    toggleCurrency, \n    formatPrice, \n    setIsCartOpen, \n    setIsDataSyncOpen, \n    setIsCallbackOpen, \n    products, \n    setSelectedProductId, \n    filters, \n    setFilters \n  } = useApp();\n\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [isSearchOpen, setIsSearchOpen] = useState(false);\n  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);\n  const [isCatalogDropdownOpen, setIsCatalogDropdownOpen] = useState(false);\n  const searchRef = useRef<HTMLDivElement>(null);\n\n  // Filter products for search auto-complete\n  const searchResults = searchQuery.trim()\n    ? products.filter(p =>\n        p.name.toLowerCase().includes(searchQuery.toLowerCase()) ||\n        p.sku.toLowerCase().includes(searchQuery.toLowerCase()) ||\n        p.brand.toLowerCase().includes(searchQuery.toLowerCase()) ||\n        p.category.toLowerCase().includes(searchQuery.toLowerCase())\n      ).slice(0, 6)\n    : [];\n\n  useEffect(() => {\n    const handleClickOutside = (event: MouseEvent) => {\n      if (searchRef.current && !searchRef.current.contains(event.target as Node)) {\n        setIsSearchOpen(false);\n      }\n    };\n    document.addEventListener(\'mousedown\', handleClickOutside);\n    return () => document.removeEventListener(\'mousedown\', handleClickOutside);\n  }, []);\n\n  const handleSelectProduct = (id: string) => {\n    setSelectedProductId(id);\n    setRoute(\'product\');\n    setIsSearchOpen(false);\n    setSearchQuery(\'\');\n  };\n\n  const handleCategoryClick = (catId: string) => {\n    setFilters(prev => ({ ...prev, category: catId }));\n    setRoute(\'catalog\');\n    setIsCatalogDropdownOpen(false);\n    setIsMobileMenuOpen(false);\n  };\n\n  return (\n    <header className=\"sticky top-0 z-40 bg-white shadow-md border-b border-slate-200\">\n      {/* Top Bar */}\n      <div className=\"bg-slate-900 text-slate-300 text-xs py-2 px-4 border-b border-slate-800\">\n        <div className=\"max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3\">\n          <div className=\"flex items-center flex-wrap gap-4 text-slate-300\">\n            <a href=\"tel:+375333772873\" className=\"flex items-center gap-1.5 hover:text-orange-400 font-semibold transition-colors\">\n              <Phone className=\"w-3.5 h-3.5 text-orange-500\" />\n              +375 (33) 377-28-73\n            </a>\n            <a href=\"mailto:sales@mzvuk.by\" className=\"flex items-center gap-1.5 hover:text-orange-400 transition-colors\">\n              <Mail className=\"w-3.5 h-3.5 text-slate-400\" />\n              sales@mzvuk.by\n            </a>\n            <span className=\"hidden md:flex items-center gap-1 text-slate-400\">\n              <MapPin className=\"w-3.5 h-3.5\" />\n              \320\263. \320\234\320\270\320\275\321\201\320\272 \342\200\242 \320\237\320\275-\320\237\321\202: 09:00 - 18:00\n            </span>\n            <span className=\"hidden lg:inline-block px-2 py-0.5 rounded bg-orange-500/10 text-orange-400 text-[11px] font-bold border border-orange-500/20\">\n              \320\240\320\260\320\261\320\276\321\202\320\260\320\265\320\274 \321\201 \320\235\320\224\320\241 20% \320\264\320\273\321\217 \320\256\321\200\320\270\320\264\320\270\321\207\320\265\321\201\320\272\320\270\321\205 \320\233\320\270\321\206\n            </span>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <button\n              onClick={() => setIsDataSyncOpen(true)}\n              className=\"flex items-center gap-1.5 px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-emerald-400 font-medium rounded-lg transition-colors border border-slate-700 text-[11px]\"\n              title=\"1C \320\241\320\270\320\275\321\205\321\200\320\276\320\275\320\270\320\267\320\260\321\206\320\270\321\217 \320\270 \321\215\320\272\321\201\320\277\320\276\321\200\321\202 \320\275\320\276\320\274\320\265\320\275\320\272\320\273\320\260\321\202\321\203\321\200\321\213\"\n            >\n              <Database className=\"w-3.5 h-3.5 text-emerald-400\" />\n              1\320\241 / \320\255\320\272\321\201\320\277\320\276\321\200\321\202 XLS\n            </button>\n\n            <button\n              onClick={toggleCurrency}\n              className=\"px-2 py-0.5 bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold rounded text-[11px] transition-colors border border-slate-700\"\n            >\n              \320\222\320\260\320\273\321\216\321\202\320\260: <span className=\"text-orange-400\">{currency}</span>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Main Header */}\n      <div className=\"max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-4\">\n        {/* Mobile menu button */}\n        <button\n          onClick={() => setIsMobileMenuOpen(!isMobileMenuOpen)}\n          className=\"lg:hidden p-2 text-slate-700 hover:text-orange-600 rounded-lg hover:bg-slate-100\"\n          aria-label=\"\320\236\321\202\320\272\321\200\321\213\321\202\321\214 \320\274\320\265\320\275\321\216\"\n        >\n          {isMobileMenuOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n        </button>\n\n        {/* Brand Logo */}\n        <div \n          onClick={() => setRoute(\'home\')}\n          className=\"flex items-center gap-3 cursor-pointer group shrink-0\"\n        >\n          <div className=\"w-10 h-10 rounded-xl bg-gradient-to-br from-orange-500 to-amber-600 flex items-center justify-center text-white shadow-md shadow-orange-500/20 group-hover:scale-105 transition-transform\">\n            <Volume2 className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <span className=\"text-xl font-extrabold tracking-tight text-slate-900 block leading-none\">\n              \320\220\321\200\321\202-\320\234\320\265\320\264\320\270\320\260 <span className=\"text-orange-600\">\320\242\321\200\320\265\320\271\320\264</span>\n            </span>\n            <span className=\"text-[11px] font-semibold text-slate-500 tracking-wider uppercase block mt-0.5\">\n              mzvuk.by \342\200\242 \320\220\321\203\320\264\320\270\320\276 \321\201\320\270\321\201\321\202\320\265\320\274\320\275\321\213\320\271 \320\270\320\275\321\202\320\265\320\263\321\200\320\260\321\202\320\276\321\200\n            </span>\n          </div>\n        </div>\n\n        {/* Catalog Button (Desktop) */}\n        <div className=\"hidden lg:block relative\">\n          <button\n            onClick={() => setIsCatalogDropdownOpen(!isCatalogDropdownOpen)}\n            className=\"flex items-center gap-2 px-4 py-2.5 bg-slate-900 hover:bg-orange-600 text-white font-bold rounded-xl transition-all shadow-md group\"\n          >\n            <Sliders className=\"w-4 h-4 text-orange-400 group-hover:text-white transition-colors\" />\n            \320\232\320\260\321\202\320\260\320\273\320\276\320\263 \321\202\320\276\320\262\320\260\321\200\320\276\320\262\n            <ChevronDown className={`w-4 h-4 transition-transform ${isCatalogDropdownOpen ? \'rotate-180\' : \'\'}`} />\n          </button>\n\n          {/* Catalog Mega Dropdown */}\n          {isCatalogDropdownOpen && (\n            <div className=\"absolute top-full left-0 mt-2 w-80 bg-white rounded-2xl shadow-2xl border border-slate-200 p-2 z-50 animate-fade-in\">\n              <div className=\"text-xs font-bold uppercase tracking-wider text-slate-400 px-3 py-2\">\n                \320\232\320\260\321\202\320\265\320\263\320\276\321\200\320\270\320\270 \320\276\320\261\320\276\321\200\321\203\320\264\320\276\320\262\320\260\320\275\320\270\321\217\n              </div>\n              <div className=\"space-y-1\">\n                {MOCK_CATEGORIES.map(cat => (\n                  <button\n                    key={cat.id}\n                    onClick={() => handleCategoryClick(cat.id)}\n                    className=\"w-full text-left px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-800 hover:bg-orange-50 hover:text-orange-600 flex items-center justify-between transition-colors group\"\n                  >\n                    <span>{cat.name}</span>\n                    <span className=\"text-xs text-slate-400 group-hover:text-orange-500\">\n                      {cat.productCount}\n                    </span>\n                  </button>\n                ))}\n              </div>\n              <div className=\"mt-2 pt-2 border-t border-slate-100\">\n                <button\n                  onClick={() => {\n                    setFilters(prev => ({ ...prev, category: \'all\' }));\n                    setRoute(\'catalog\');\n                    setIsCatalogDropdownOpen(false);\n                  }}\n                  className=\"w-full py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold rounded-xl text-center transition-colors\"\n                >\n                  \320\237\320\276\321\201\320\274\320\276\321\202\321\200\320\265\321\202\321\214 \320\262\320\265\321\201\321\214 \320\272\320\260\321\202\320\260\320\273\320\276\320\263 ({products.length})\n                </button>\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* Search Bar with Autocomplete */}\n        <div ref={searchRef} className=\"flex-1 max-w-xl relative hidden md:block\">\n          <div className=\"relative\">\n            <input\n              type=\"text\"\n              value={searchQuery}\n              onChange={e => {\n                setSearchQuery(e.target.value);\n                setIsSearchOpen(true);\n              }}\n              onFocus={() => setIsSearchOpen(true)}\n              placeholder=\"\320\237\320\276\320\270\321\201\320\272 \320\277\320\276 \320\272\320\260\321\202\320\260\320\273\320\276\320\263\321\203 (\320\275\320\260\320\277\321\200\320\270\320\274\320\265\321\200: Yamaha, Shure, \320\274\320\270\320\272\321\200\320\276\321\204\320\276\320\275)...\"\n              className=\"w-full pl-10 pr-4 py-2.5 bg-slate-100 focus:bg-white border border-slate-200 focus:border-orange-500 rounded-xl text-sm outline-none transition-all\"\n            />\n            <Search className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-3.5\" />\n            {searchQuery && (\n              <button\n                onClick={() => setSearchQuery(\'\')}\n                className=\"absolute right-3 top-3 text-xs text-slate-400 hover:text-slate-600\"\n              >\n                \320\236\321\207\320\270\321\201\321\202\320\270\321\202\321\214\n              </button>\n            )}\n          </div>\n\n          {/* Autocomplete Popup */}\n          {isSearchOpen && searchResults.length > 0 && (\n            <div className=\"absolute top-full left-0 right-0 mt-2 bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden z-50\">\n              <div className=\"p-2 divide-y divide-slate-100\">\n                {searchResults.map(prod => (\n                  <div\n                    key={prod.id}\n                    onClick={() => handleSelectProduct(prod.id)}\n                    className=\"p-2.5 hover:bg-orange-50 cursor-pointer rounded-xl flex items-center gap-3 transition-colors\"\n                  >\n                    <img\n                      src={prod.image}\n                      alt={prod.name}\n                      className=\"w-12 h-12 object-cover rounded-lg bg-slate-100 border shrink-0\"\n                    />\n                    <div className=\"flex-1 min-w-0\">\n                      <div className=\"text-xs font-bold text-orange-600\">{prod.brand}</div>\n                      <div className=\"text-sm font-semibold text-slate-900 truncate\">{prod.name}</div>\n                      <div className=\"text-xs text-slate-500\">\320\220\321\200\321\202\320\270\320\272\321\203\320\273: {prod.sku}</div>\n                    </div>\n                    <div className=\"text-right\">\n                      <span className=\"text-sm font-extrabold text-slate-900 block\">\n                        {formatPrice(prod.priceBYN)}\n                      </span>\n                      {prod.inStock ? (\n                        <span className=\"text-[10px] text-emerald-600 font-bold\">\320\222 \320\275\320\260\320\273\320\270\321\207\320\270\320\270</span>\n                      ) : (\n                        <span className=\"text-[10px] text-slate-400\">\320\237\320\276\320\264 \320\267\320\260\320\272\320\260\320\267</span>\n                      )}\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* Action Controls */}\n        <div className=\"flex items-center gap-2\">\n          {/* Wishlist */}\n          <button\n            onClick={() => setRoute(\'catalog\')}\n            className=\"relative p-2.5 text-slate-700 hover:text-orange-600 hover:bg-orange-50 rounded-xl transition-colors\"\n            title=\"\320\230\320\267\320\261\321\200\320\260\320\275\320\275\320\276\320\265\"\n          >\n            <Heart className=\"w-5 h-5\" />\n            {wishlist.length > 0 && (\n              <span className=\"absolute -top-1 -right-1 w-5 h-5 bg-orange-600 text-white text-[10px] font-bold rounded-full flex items-center justify-center\">\n                {wishlist.length}\n              </span>\n            )}\n          </button>\n\n          {/* Comparison */}\n          <button\n            onClick={() => setRoute(\'catalog\')}\n            className=\"relative p-2.5 text-slate-700 hover:text-orange-600 hover:bg-orange-50 rounded-xl transition-colors hidden sm:block\"\n            title=\"\320\241\321\200\320\260\320\262\320\275\320\265\320\275\320\270\320\265\"\n          >\n            <ArrowLeftRight className=\"w-5 h-5\" />\n            {compareList.length > 0 && (\n              <span className=\"absolute -top-1 -right-1 w-5 h-5 bg-slate-800 text-white text-[10px] font-bold rounded-full flex items-center justify-center\">\n                {compareList.length}\n              </span>\n            )}\n          </button>\n\n          {/* Cart Button */}\n          <button\n            onClick={() => setIsCartOpen(true)}\n            className=\"flex items-center gap-3 px-3.5 py-2 bg-orange-50 border border-orange-200 hover:border-orange-500 rounded-xl transition-all group\"\n          >\n            <div className=\"relative\">\n              <ShoppingCart className=\"w-5 h-5 text-orange-600 group-hover:scale-110 transition-transform\" />\n              {cartTotalCount > 0 && (\n                <span className=\"absolute -top-2 -right-2.5 w-5 h-5 bg-orange-600 text-white text-[10px] font-bold rounded-full flex items-center justify-center shadow\">\n                  {cartTotalCount}\n                </span>\n              )}\n            </div>\n            <div className=\"text-left hidden sm:block\">\n              <span className=\"text-[10px] uppercase font-bold text-slate-500 block leading-none\">\320\232\320\276\321\200\320\267\320\270\320\275\320\260</span>\n              <span className=\"text-xs font-extrabold text-slate-900 block mt-0.5\">\n                {cartTotalBYN > 0 ? formatPrice(cartTotalBYN) : \'\320\237\321\203\321\201\321\202\320\276\'}\n              </span>\n            </div>\n          </button>\n\n          {/* Call Back Request Button */}\n          <button\n            onClick={() => setIsCallbackOpen(true)}\n            className=\"hidden xl:flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-orange-500 to-amber-600 hover:from-orange-600 hover:to-amber-700 text-white font-bold rounded-xl text-xs shadow-md shadow-orange-500/20 transition-all active:scale-95\"\n          >\n            <Phone className=\"w-3.5 h-3.5\" />\n            \320\227\320\260\320\272\320\260\320\267\320\260\321\202\321\214 \320\267\320\262\320\276\320\275\320\276\320\272\n          </button>\n        </div>\n      </div>\n\n      {/* Main Nav Menu Bar (Desktop) */}\n      <nav className=\"hidden lg:block bg-slate-100 border-t border-slate-200\">\n        <div className=\"max-w-7xl mx-auto px-4 flex items-center gap-1 overflow-x-auto text-xs font-bold text-slate-700\">\n          <button\n            onClick={() => setRoute(\'home\')}\n            className={`px-4 py-3 hover:text-orange-600 transition-colors border-b-2 ${\n              route === \'home\' ? \'border-orange-600 text-orange-600 bg-white\' : \'border-transparent\'\n            }`}\n          >\n            \320\223\320\273\320\260\320\262\320\275\320\260\321\217\n          </button>\n\n          <button\n            onClick={() => setRoute(\'catalog\')}\n            className={`px-4 py-3 hover:text-orange-600 transition-colors border-b-2 ${\n              route === \'catalog\' ? \'border-orange-600 text-orange-600 bg-white\' : \'border-transparent\'\n            }`}\n          >\n            \320\232\320\260\321\202\320\260\320\273\320\276\320\263 \320\276\320\261\320\276\321\200\321\203\320\264\320\276\320\262\320\260\320\275\320\270\321\217\n          </button>\n\n          <button\n            onClick={() => setRoute(\'services\')}\n            className={`px-4 py-3 hover:text-orange-600 transition-colors border-b-2 ${\n              route === \'services\' ? \'border-orange-600 text-orange-600 bg-white\' : \'border-transparent\'\n            }`}\n          >\n            \320\243\321\201\320\273\321\203\320\263\320\270 \320\270 \320\274\320\276\320\275\321\202\320\260\320\266\n          </button>\n\n          <button\n            onClick={() => setRoute(\'about\')}\n            className={`px-4 py-3 hover:text-orange-600 transition-colors border-b-2 ${\n              route === \'about\' ? \'border-orange-600 text-orange-600 bg-white\' : \'border-transparent\'\n            }`}\n          >\n            \320\236 \320\272\320\276\320\274\320\277\320\260\320\275\320\270\320\270\n          </button>\n\n          <button\n            onClick={() => setRoute(\'certificates\')}\n            className={`px-4 py-3 hover:text-orange-600 transition-colors border-b-2 ${\n              route === \'certificates\' ? \'border-orange-600 text-orange-600 bg-white\' : \'border-transparent\'\n            }`}\n          >\n            \320\241\320\265\321\200\321\202\320\270\321\204\320\270\320\272\320\260\321\202\321\213\n          </button>\n\n          <button\n            onClick={() => setRoute(\'news\')}\n            className={`px-4 py-3 hover:text-orange-600 transition-colors border-b-2 ${\n              route === \'news\' ? \'border-orange-600 text-orange-600 bg-white\' : \'border-transparent\'\n            }`}\n          >\n            \320\235\320\276\320\262\320\276\321\201\321\202\320\270 \320\270 \321\201\321\202\320\260\321\202\321\214\320\270\n          </button>\n\n          <button\n            onClick={() => setRoute(\'faq\')}\n            className={`px-4 py-3 hover:text-orange-600 transition-colors border-b-2 ${\n              route === \'faq\' ? \'border-orange-600 text-orange-600 bg-white\' : \'border-transparent\'\n            }`}\n          >\n            \320\222\320\276\320\277\321\200\320\276\321\201-\320\276\321\202\320\262\320\265\321\202 (FAQ)\n          </button>\n\n          <button\n            onClick={() => setRoute(\'partners\')}\n            className={`px-4 py-3 hover:text-orange-600 transition-colors border-b-2 ${\n              route === \'partners\' ? \'border-orange-600 text-orange-600 bg-white\' : \'border-transparent\'\n            }`}\n          >\n            \320\221\321\200\320\265\320\275\320\264\321\213 \320\270 \320\277\320\260\321\200\321\202\320\275\320\265\321\200\321\213\n          </button>\n\n          <button\n            onClick={() => setRoute(\'delivery\')}\n            className={`px-4 py-3 hover:text-orange-600 transition-colors border-b-2 ${\n              route === \'delivery\' ? \'border-orange-600 text-orange-600 bg-white\' : \'border-transparent\'\n            }`}\n          >\n            \320\236\320\277\320\273\320\260\321\202\320\260 \320\270 \320\264\320\276\321\201\321\202\320\260\320\262\320\272\320\260\n          </button>\n\n          <button\n            onClick={() => setRoute(\'contacts\')}\n            className={`px-4 py-3 hover:text-orange-600 transition-colors border-b-2 ${\n              route === \'contacts\' ? \'border-orange-600 text-orange-600 bg-white\' : \'border-transparent\'\n            }`}\n          >\n            \320\232\320\276\320\275\321\202\320\260\320\272\321\202\321\213\n          </button>\n        </div>\n      </nav>\n\n      {/* Mobile Drawer Navigation */}\n      {isMobileMenuOpen && (\n        <div className=\"lg:hidden bg-slate-900 text-white p-4 border-t border-slate-800 space-y-3 animate-fade-in\">\n          <div className=\"relative mb-3\">\n            <input\n              type=\"text\"\n              value={searchQuery}\n              onChange={e => setSearchQuery(e.target.value)}\n              placeholder=\"\320\237\320\276\320\270\321\201\320\272 \320\277\320\276 \321\201\320\260\320\271\321\202\321\203...\"\n              className=\"w-full pl-9 pr-4 py-2 bg-slate-800 border border-slate-700 rounded-xl text-xs text-white outline-none\"\n            />\n            <Search className=\"w-4 h-4 text-slate-400 absolute left-3 top-2.5\" />\n          </div>\n\n          <div className=\"grid grid-cols-1 gap-1 text-sm font-semibold\">\n            {[\n              { id: \'home\', label: \'\320\223\320\273\320\260\320\262\320\275\320\260\321\217\' },\n              { id: \'catalog\', label: \'\320\232\320\260\321\202\320\260\320\273\320\276\320\263 \320\276\320\261\320\276\321\200\321\203\320\264\320\276\320\262\320\260\320\275\320\270\321\217\' },\n              { id: \'services\', label: \'\320\243\321\201\320\273\321\203\320\263\320\270 \320\270 \320\274\320\276\320\275\321\202\320\260\320\266\' },\n              { id: \'about\', label: \'\320\236 \320\272\320\276\320\274\320\277\320\260\320\275\320\270\320\270\' },\n              { id: \'certificates\', label: \'\320\241\320\265\321\200\321\202\320\270\321\204\320\270\320\272\320\260\321\202\321\213 \320\270 \320\264\320\276\320\272\321\203\320\274\320\265\320\275\321\202\321\213\' },\n              { id: \'news\', label: \'\320\235\320\276\320\262\320\276\321\201\321\202\320\270 \320\270 \321\201\321\202\320\260\321\202\321\214\320\270\' },\n              { id: \'faq\', label: \'\320\247\320\260\321\201\321\202\321\213\320\265 \320\262\320\276\320\277\321\200\320\276\321\201\321\213 (FAQ)\' },\n              { id: \'partners\', label: \'\320\237\320\260\321\200\321\202\320\275\321\221\321\200\321\213 \320\270 \320\261\321\200\320\265\320\275\320\264\321\213\' },\n              { id: \'delivery\', label: \'\320\236\320\277\320\273\320\260\321\202\320\260 \320\270 \320\264\320\276\321\201\321\202\320\260\320\262\320\272\320\260\' },\n              { id: \'contacts\', label: \'\320\232\320\276\320\275\321\202\320\260\320\272\321\202\321\213\' },\n            ].map(item => (\n              <button\n                key={item.id}\n                onClick={() => {\n                  setRoute(item.id as PageRoute);\n                  setIsMobileMenuOpen(false);\n                }}\n                className={`text-left px-3 py-2.5 rounded-lg transition-colors ${\n                  route === item.id ? \'bg-orange-600 text-white font-bold\' : \'hover:bg-slate-800 text-slate-300\'\n                }`}\n              >\n                {item.label}\n              </button>\n            ))}\n          </div>\n\n          <div className=\"pt-3 border-t border-slate-800 flex flex-col gap-2\">\n            <button\n              onClick={() => {\n                setIsCallbackOpen(true);\n                setIsMobileMenuOpen(false);\n              }}\n              className=\"w-full py-2.5 bg-orange-600 hover:bg-orange-700 text-white font-bold rounded-xl text-center text-xs\"\n            >\n              \320\227\320\260\320\272\320\260\320\267\320\260\321\202\321\214 \320\267\320\262\320\276\320\275\320\276\320\272\n            </button>\n          </div>\n        </div>\n      )}\n    </header>\n  );\n};\n"
