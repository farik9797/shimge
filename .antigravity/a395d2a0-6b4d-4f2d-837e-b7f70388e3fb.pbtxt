      <div className=\"text-xs font-bold text-emerald-600 bg-emerald-50 p-2.5 rounded-xl\">\n            \320\221\320\265\321\201\320\277\320\273\320\260\321\202\320\275\320\276 \320\264\320\273\321\217 \320\273\321\216\320\261\321\213\321\205 \321\201\321\203\320\274\320\274\n          </div>\n        </div>\n      </div>\n\n      {/* Payment Options Grid */}\n      <div className=\"bg-slate-900 text-white rounded-3xl p-8 border border-slate-800 space-y-6\">\n        <div>\n          <span className=\"text-xs font-bold text-orange-500 uppercase tracking-widest block mb-1\">\n            \320\244\320\270\320\275\320\260\320\275\321\201\320\276\320\262\321\213\320\265 \321\203\321\201\320\273\320\276\320\262\320\270\321\217\n          </span>\n          <h2 className=\"text-2xl font-black text-white\">\320\241\320\277\320\276\321\201\320\276\320\261\321\213 \320\276\320\277\320\273\320\260\321\202\321\213 \320\270 \320\267\320\260\320\272\321\200\321\213\320\262\320\260\321\216\321\211\320\270\320\265 \320\264\320\276\320\272\321\203\320\274\320\265\320\275\321\202\321\213</h2>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-slate-300\">\n          <div className=\"p-5 bg-slate-800/80 rounded-2xl border border-slate-700 space-y-3\">\n            <div className=\"flex items-center gap-2 font-bold text-white text-sm\">\n              <Percent className=\"w-5 h-5 text-orange-400\" />\n              <span>\320\221\320\265\320\267\320\275\320\260\320\273\320\270\321\207\320\275\321\213\320\271 \321\200\320\260\321\201\321\207\320\265\321\202 \321\201 \320\235\320\224\320\241 20% (\320\256\320\240 \320\273\320\270\321\206\320\260 \320\270 \320\230\320\237)</span>\n            </div>\n            <p className=\"leading-relaxed\">\n              \320\222\321\213\321\201\321\202\320\260\320\262\320\273\321\217\320\265\320\274 \321\201\321\207\321\221\321\202-\321\204\320\260\320\272\321\202\321\203\321\200\321\203 \320\275\320\26