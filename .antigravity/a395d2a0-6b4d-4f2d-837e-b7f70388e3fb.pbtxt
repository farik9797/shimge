    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { ShieldCheck, Percent, Truck, Wrench, Award, Building2 } from \'lucide-react\';\n\nconst ADVANTAGES = [\n  {\n    icon: <Award className=\"w-8 h-8 text-orange-500\" />,\n    title: \'\320\236\321\204\320\270\321\206\320\270\320\260\320\273\321\214\320\275\321\213\320\271 \320\264\320\270\320\273\320\265\321\200 50+ \320\261\321\200\320\265\320\275\320\264\320\276\320\262\',\n    desc: \'\320\237\321\200\321\217\320\274\321\213\320\265 \320\277\320\276\321\201\321\202\320\260\320\262\320\272\320\270 \320\276\320\261\320\276\321\200\321\203\320\264\320\276\320\262\320\260\320\275\320\270\321\217 \320\276\321\202 \320\277\321\200\320\276\320\270\320\267\320\262\320\276\320\264\320\270\321\202\320\265\320\273\320\265\320\271 Yamaha, Shure, JBL, Sennheiser \320\261\320\265\320\267 \320\277\320\276\321\201\321\200\320\265\320\264\320\275\320\270\320\272\320\276\320\262.\'\n  },\n  {\n    icon: <Percent className=\"w-8 h-8 text-orange-500\" />,\n    title: \'\320\240\320\260\320\261\320\276\321\202\320\260 \321\201 \320\235\320\224\320\241 20%\',\n    desc: \'\320\237\320\276\320\273\320\275\321\213\320\271 \320\272\320\276\320\274\320\277\320\273\320\265\320\272\321\202 \320\267\320\260\320\272\321\200\321\213\320\262\320\260\321\216\321\211\320\270\321\205 \320\261\321\203\321\205\320\263\320\260\320\273\321\202\320\265\321\200\321\201\320\272\320\270\321\205 \320\264\320\276\320\272\321\203\320\274\320\265\320\275\321\202\320\276\320\262 (\320\242\320\242\320\235, \320\242\320\235, \321\201\321\207\320\265\321\202\320\260-\321\204\320\260\320\272\321\202\321\203\321\200\321\213) \320\264\320\273\321\217 \320\256\320\240 \320\273\320\270\321\206 \320\270 \320\230\320\237.\'\n  },\n  {\n    icon: <Wrench className=\"w-8 h-8 text-orange-500\" />,\n    title: \'\320\241\320\276\320\261\321\201\321\202\320\262\320\265\320\275\320\275\321\213\320\271 \321\201\320\265\321\200\320\262\320\270\321\201\320\275\321\213\320\271 \321\206\320\265\320\275\321\202\321\200\',\n    desc: \'\320\220\320\262\321\202\320\276\321\200\320\270\320\267\320\276\320\262\320\260\320\275\320\275\320\260\321\217 \320\264\320\270\320\260\320\263\320\275\320\276\321\201\321\202\320\270\320\272\320\260 \320\270 \321\200\320\265\320\274\320\276\320\275\321\202 \320\267\320\262\321\203\320\272\320\276\320\262\320\276\320\263\320\276 \320\276\320\261\320\276\321\200\321\203\320\264\320\276\320\262\320\260\320\275\320\270\321\217 \320\262 \320\234\320\270\320\275\321\201\320\272\320\265 \321\201 \320\276\321\200\320\270\320\263\320\270\320\275\320\260\320\273\321\214\320\275\321\213\320\274\320\270 \320\267\320\260\320\277\321\207\320\260\321\201\321\202\321\217\320\274\320\270.\'\n  },\n  {\n    icon: <Truck className=\"w-8 h-8 text-orange-500\" />,\n    title: \'\320\224\320\276\321\201\321\202\320\260\320\262\320\272\320\260 \320\277\320\276 \320\221\320\265\320\273\320\260\321\200\321\203\321\201\320\270 \320\267\320\260 24\321\207\',\n    desc: \'\320\236\320\277\320\265\321\200\320\260\321\202\320\270\320\262\320\275\320\260\321\217 \320\264\320\276\321\201\321\202\320\260\320\262\320\272\320\260 \320\272\321\203\321\200\321\214\320\265\321\200\321\201\320\272\320\276\320\271 \321\201\320\273\321\203\320\266\320\261\320\276\320\271 DPD/Autolight \320\277\320\276 \320\234\320\270\320\275\321\201\320\272\321\203, \320\276\320\261\320\273\320\260\321\201\321\202\320\275\321\213\320\274 \320\270 \321\200\320\260\320\271\320\276\320\275\320\275\321\213\320\274 \321\206\320\265\320\275\321\202\321\200\320\260\320\274 \320\240\320\221.\'\n  },\n  {\n    icon: <ShieldCheck className=\"w-8 h-8 text-orange-500\" />,\n    title: \'\320\223\320\260\321\200\320\260\320\275\321\202\320\270\321\217 \320\264\320\276 36 \320\274\320\265\321\201\321\217\321\206\320\265\320\262\',\n    desc: \'100% \320\267\320\260\321\211\320\270\321\202\320\260 \320\277\321\200\320\260\320\262 \320\277\320\276\321\202\321\200\320\265\320\261\320\270\321\202\320\265\320\273\321\217 \320\270 \321\200\320\260\321\201\321\210\320\270\321\200\320\265\320\275\320\275\320\260\321\217 \320\276\321\204\320\270\321\206\320\270\320\260\320\273\321\214\320\275\320\260\321\217 \320\263\320\260\321\200\320\260\320\275\321\202\320\270\321\217 \320\275\320\260 \320\262\320\265\321\201\321\214 \320\260\321\201\321\201\320\276\321\200\321\202\320\270\320\274\320\265\320\275\321\202 \320\272\320\260\321\202\320\260\320\273\320\276\320\263\320\260.\'\n  },\n  {\n    icon: <Building2 className=\"w-8 h-8 text-orange-500\" />,\n    title: \'1500+ \321\200\320\265\320\260\320\273\320\270\320\267\320\276\320\262\320\260\320\275\320\275\321\213\321\205 \320\276\320\261\321\212\320\265\320\272\321\202\320\276\320\262\',\n    desc: \'\320\243\321\201\320\277\320\265\321\210\320\275\320\276 \320\276\321\201\320\275\320\260\321\211\320\265\320\275\320\275\321\213\320\265 \320\267\320\262\321\203\320\272\320\276\320\274 \321\200\320\265\321\201\321\202\320\276\321\200\320\260\320\275\321\213, \321\210\320\272\320\276\320\273\321\213, \320\242\320\240\320\246, \321\204\320\270\321\202\320\275\320\265\321\201-\320\272\320\273\321\203\320\261\321\213 \320\270 \320\272\320\276\320\275\321\206\320\265\321\200\321\202\320\275\321\213\320\265 \320\267\320\260\320\273\321\213 \320\277\320\276 \320\262\321\201\320\265\320\271 \320\221\320\265\320\273\320\260\321\200\321\203\321\201\320\270.\'\n  }\n];\n\nexport const WhyUs: React.FC = () => {\n  return (\n    <section className=\"max-w-7xl mx-auto px-4 py-12\">\n      <div className=\"text-center max-w-2xl mx-auto mb-10\">\n        <h2 className=\"text-2xl md:text-3xl font-black text-slate-900 tracking-tight\">\n          \320\237\320\276\321\207\320\265\320\274\321\203 \320\262\321\213\320\261\320\270\321\200\320\260\321\216\321\202 \320\236\320\236\320\236 \302\253\320\220\321\200\321\202-\320\234\320\265\320\264\320\270\320\260 \320\242\321\200\320\265\320\271\320\264\302\273\n        </h2>\n        <p className=\"text-xs md:text-sm text-slate-500 mt-2\">\n          \320\235\320\260\320\264\320\265\320\266\320\275\321\213\320\271 \320\277\320\276\321\201\321\202\320\260\320\262\321\211\320\270\320\272 \320\277\321\200\320\276\321\204\320\265\321\201\321\201\320\270\320\276\320\275\320\260\320\273\321\214\320\275\320\276\320\271 \320\260\321\203\320\264\320\270\320\276 \320\270 \320\267\320\262\321\203\320\272\320\276\320\262\320\276\320\271 \321\202\320\265\321\205\320\275\320\270\320\272\320\270 \320\262 \320\240\320\265\321\201\320\277\321\203\320\261\320\273\320\270\320\272\320\265 \320\221\320\265\320\273\320\260\321\200\321\203\321\201\321\214\n        </p>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n        {ADVANTAGES.map((adv, i) => (\n          <div\n            key={i}\n            className=\"p-6 bg-white rounded-2xl border border-slate-200 hover:border-orange-500/80 hover:shadow-lg transition-all\"\n          >\n            <div className=\"p-3 bg-orange-50 rounded-2xl w-fit mb-4\">\n              {adv.icon}\n            </div>\n            <h3 className=\"text-base font-bold text-slate-900 mb-2\">{adv.title}</h3>\n            <p className=\"text-xs text-slate-600 leading-relaxed\">{adv.desc}</p>\n          </div>\n        ))}\n      </div>\n    </section>\n  );\n};\n"
    }
