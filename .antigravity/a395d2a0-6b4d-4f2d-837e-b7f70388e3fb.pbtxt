    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { HeroSlider } from \'./HeroSlider\';\nimport { CategoriesGrid } from \'./CategoriesGrid\';\nimport { ProductShowcase } from \'./ProductShowcase\';\nimport { ServicesSection } from \'./ServicesSection\';\nimport { WhyUs } from \'./WhyUs\';\nimport { AudioConfigurator } from \'./AudioConfigurator\';\nimport { BrandCarousel } from \'./BrandCarousel\';\nimport { MOCK_NEWS, MOCK_ARTICLES } from \'../../data/mockData\';\nimport { Newspaper, BookOpen, ArrowRight, Send, CheckCircle2, Phone, Mail } from \'lucide-react\';\n\nexport const HomePage: React.FC = () => {\n  const { setRoute, showNotification } = useApp();\n  const [formName, setFormName] = useState(\'\');\n  const [formPhone, setFormPhone] = useState(\'\');\n  const [formMessage, setFormMessage] = useState(\'\');\n  const [isSent, setIsSent] = useState(false);\n\n  const handleFeedbackSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!formPhone) return;\n    setIsSent(true);\n    showNotification(\'\320\241\320\276\320\276\320\261\321\211\320\265\320\275\320\270\320\265 \321\203\321\201\320\277\320\265\321\210\320\275\320\276 \320\276\321\202\320\277\321\200\320\260\320\262\320\273\320\265\320\275\320\276 \320\262 \320\276\321\202\320\264\320\265\320\273 \320\277\321\200\320\276\320\264\320\260\320\266!\', \'success\');\n    setTimeout(() => {\n      setIsSent(false);\n      setFormName(\'\');\n      setFormPhone(\'\');\n      setFormMessage(\'\');\n    }, 3000);\n  };\n\n  return (\n    <div className=\"space-y-6 pb-12 animate-fade-in\">\n      <HeroSlider />\n      <CategoriesGrid />\n      <ProductShowcase />\n      <AudioConfigurator />\n      <ServicesSection />\n      <WhyUs />\n      <BrandCarousel />\n\n      {/* News & Articles Teaser */}\n      <section className=\"max-w-7xl mx-auto px-4 py-10\">\n        <div className=\"flex items-center justify-between mb-8\">\n          <div>\n            <h2 className=\"text-2xl font-black text-slate-900 tracking-tight\">\n              \320\235\320\276\320\262\320\276\321\201\321\202\320\270 \320\270 \320\277\320\276\320\273\320\265\320\267\320\275\321\213\320\265 \321\201\321\202\320\260\321\202\321\214\320\270\n            </h2>\n            <p className=\"text-xs text-slate-500 mt-1\">\n              \320\236\320\261\320\267\320\276\321\200\321\213 \320\276\320\261\320\276\321\200\321\203\320\264\320\276\320\262\320\260\320\275\320\270\321\217, \321\200\320\265\320\272\320\276\320\274\320\265\320\275\320\264\320\260\321\206\320\270\320\270 \321\215\320\272\321\201\320\277\320\265\321\200\321\202\320\276\320\262 mzvuk.by \320\270 \320\275\320\260\321\210\320\270 \320\270\320\275\321\201\321\202\320\260\320\273\320\273\321\217\321\206\320\270\320\276\320\275\320\275\321\213\320\265 \320\277\321\200\320\276\320\265\320\272\321\202\321\213\n            </p>\n          </div>\n          <button\n            onClick={() => setRoute(\'news\')}\n            className=\"text-xs font-bold text-orange-600 hover:text-orange-700 flex items-center gap-1\"\n          >\n            \320\222\321\201\320\265 \320\277\321\203\320\261\320\273\320\270\320\272\320\260\321\206\320\270\320\270 <ArrowRight className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n          {/* News Item 1 */}\n          <div\n            onClick={() => setRoute(\'news\')}\n            className=\"bg-white rounded-2xl border border-slate-200 overflow-hidden hover:border-orange-500 hover:shadow-lg transition-all cursor-pointer group flex flex-col justify-between\"\n          >\n            <div>\n              <div className=\"relative h-44 overflow-hidden\">\n                <img\n                  src={MOCK_NEWS[0].image}\n                  alt={MOCK_NEWS[0].title}\n                  className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\"\n                />\n                <span className=\"absolute top-3 left-3 px-2.5 py-1 bg-slate-900/90 text-white text-[10px] font-bold rounded-lg backdrop-blur\">\n                  {MOCK_NEWS[0].category}\n                </span>\n              </div>\n              <div className=\"p-5\">\n                <span className=\"text-[11px] font-bold text-slate-400 block mb-1\">{MOCK_NEWS[0].date}</span>\n                <h3 className=\"text-sm font-bold text-slate-900 group-hover:text-orange-600 transition-colors line-clamp-2\">\n                  {MOCK_NEWS[0].title}\n                </h3>\n                <p className=\"text-xs text-slate-600 mt-2 line-clamp-2\">{MOCK_NEWS[0].summary}</p>\n              </div>\n            </div>\n            <div className=\"px-5 pb-5 pt-0\">\n              <span className=\"text-xs font-bold text-orange-600 inline-flex items-center gap-1\">\n                \320\247\320\270\321\202\320\260\321\202\321\214 \320\264\320\260\320\273\320\265\320\265 <ArrowRight className=\"w-3.5 h-3.5\" />\n              </span>\n            </div>\n          </div>\n\n          {/* Article Item 1 */}\n          <div\n            onClick={() => setRoute(\'articles\')}\n            className=\"bg-white rounded-2xl border border-slate-200 overflow-hidden hover:border-orange-500 hover:shadow-lg transition-all cursor-pointer group flex flex-col justify-between\"\n          >\n            <div>\n              <div className=\"relative h-44 overflow-hidden\">\n                <img\n                  src={MOCK_ARTICLES[0].image}\n                  alt={MOCK_ARTICLES[0].title}\n                  className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\"\n                />\n                <span className=\"absolute top-3 left-3 px-2.5 py-1 bg-orange-600 text-white text-[10px] font-bold rounded-lg shadow\">\n                  \320\240\321\203\320\272\320\276\320\262\320\276\320\264\321\201\321\202\320\262\320\276\n                </span>\n              </div>\n              <div className=\"p-5\">\n                <span className=\"text-[11px] font-bold text-slate-400 block mb-1\">{MOCK_ARTICLES[0].date}</span>\n                <h3 className=\"text-sm font-bold text-slate-900 group-hover:text-orange-600 transition-colors line-clamp-2\">\n                  {MOCK_ARTICLES[0].title}\n                </h3>\n                <p className=\"text-xs text-slate-600 mt-2 line-clamp-2\">{MOCK_ARTICLES[0].summary}</p>\n              </div>\n            </div>\n            <div className=\"px-5 pb-5 pt-0\">\n              <span className=\"text-xs font-bold text-orange-600 inline-flex items-center gap-1\">\n                \320\247\320\270\321\202\320\260\321\202\321\214 \321\201\321\202\320\260\321\202\321\214\321\216 <ArrowRight className=\"w-3.5 h-3.5\" />\n              </span>\n            </div>\n          </div>\n\n          {/* Article Item 2 */}\n          <div\n            onClick={() => setRoute(\'articles\')}\n            className=\"bg-white rounded-2xl border border-slate-200 overflow-hidden hover:border-orange-500 hover:shadow-lg transition-all cursor-pointer group flex flex-col justify-between\"\n          >\n            <div>\n              <div className=\"relative h-44 overflow-hidden\">\n                <img\n                  src={MOCK_ARTICLES[1].image}\n                  alt={MOCK_ARTICLES[1].title}\n                  className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\"\n                />\n                <span className=\"absolute top-3 left-3 px-2.5 py-1 bg-blue-600 text-white text-[10px] font-bold rounded-lg shadow\">\n                  \320\236\320\261\320\267\320\276\321\200\n                </span>\n              </div>\n              <div className=\"p-5\">\n                <span className=\"text-[11px] font-bold text-slate-400 block mb-1\">{MOCK_ARTICLES[1].date}</span>\n                <h3 className=\"text-sm font-bold text-slate-900 group-hover:text-orange-600 transition-colors line-clamp-2\">\n                  {MOCK_ARTICLES[1].title}\n                </h3>\n                <p className=\"text-xs text-slate-600 mt-2 line-clamp-2\">{MOCK_ARTICLES[1].summary}</p>\n              </div>\n            </div>\n            <div className=\"px-5 pb-5 pt-0\">\n              <span className=\"text-xs font-bold text-orange-600 inline-flex items-center gap-1\">\n                \320\247\320\270\321\202\320\260\321\202\321\214 \321\201\321\202\320\260\321\202\321\214\321\216 <ArrowRight className=\"w-3.5 h-3.5\" />\n              </span>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* Main Feedback Form */}\n      <section className=\"max-w-7xl mx-auto px-4 py-10\">\n        <div className=\"bg-slate-900 text-white rounded-3xl p-8 md:p-12 grid grid-cols-1 lg:grid-cols-2 gap-8 items-center border border-slate-800\">\n          <div>\n            <span className=\"text-xs font-bold text-orange-500 uppercase tracking-widest block mb-1\">\n              \320\236\320\261\321\200\320\260\321\202\320\275\320\260\321\217 \321\201\320\262\321\217\320\267\321\214\n            </span>\n            <h2 className=\"text-2xl md:text-3xl font-black text-white tracking-tight\">\n              \320\236\321\201\321\202\320\260\320\273\320\270\321\201\321\214 \320\262\320\276\320\277\321\200\320\276\321\201\321\213 \320\277\320\276 \320\277\320\276\320\264\320\261\320\276\321\200\321\203 \320\276\320\261\320\276\321\200\321\203\320\264\320\276\320\262\320\260\320\275\320\270\321\217?\n            </h2>\n            <p className=\"text-xs md:text-sm text-slate-300 mt-3 leading-relaxed\">\n              \320\227\320\260\320\277\320\276\320\273\320\275\320\270\321\202\320\265 \321\204\320\276\321\200\320\274\321\203, \320\270 \320\263\320\273\320\260\320\262\320\275\321\213\320\271 \320\270\320\275\320\266\320\265\320\275\320\265\321\200 \320\236\320\236\320\236 \302\253\320\220\321\200\321\202-\320\234\320\265\320\264\320\270\320\260 \320\242\321\200\320\265\320\271\320\264\302\273 \320\277\321\200\320\276\320\272\320\276\320\275\321\201\321\203\320\273\321\214\321\202\320\270\321\200\321\203\320\265\321\202 \320\262\320\260\321\201 \320\277\320\276 \320\275\320\260\320\273\320\270\321\207\320\270\321\216, \321\206\320\265\320\275\320\260\320\274 \321\201 \320\235\320\224\320\241 20% \320\270 \320\277\320\276\320\274\320\276\320\266\320\265\321\202 \320\277\320\276\320\264\320\263\320\276\321\202\320\276\320\262\320\270\321\202\321\214 \321\201\320\277\320\265\321\206\320\270\321\204\320\270\320\272\320\260\321\206\320\270\321\216.\n            </p>\n\n            <div className=\"space-y-3 mt-6 text-xs text-slate-300\">\n              <a href=\"tel:+375333772873\" className=\"flex items-center gap-3 hover:text-orange-400 font-bold\">\n                <div className=\"p-2 bg-orange-500/20 text-orange-400 rounded-lg\">\n                  <Phone className=\"w-4 h-4\" />\n                </div>\n                <span>+375 (33) 377-28-73 (\320\234\320\270\320\275\321\201\320\272)</span>\n              </a>\n              <a href=\"mailto:sales@mzvuk.by\" className=\"flex items-center gap-3 hover:text-orange-400\">\n                <div className=\"p-2 bg-slate-800 text-slate-300 rounded-lg\">\n                  <Mail className=\"w-4 h-4\" />\n                </div>\n                <span>sales@mzvuk.by</span>\n              </a>\n            </div>\n          </div>\n\n          <div className=\"bg-slate-800/90 rounded-2xl p-6 border border-slate-700\">\n            {isSent ? (\n              <div className=\"text-center py-10 space-y-3\">\n                <CheckCircle2 className=\"w-16 h-16 text-emerald-400 mx-auto\" />\n                <h3 className=\"text-lg font-bold text-white\">\320\227\320\260\321\217\320\262\320\272\320\260 \321\203\321\201\320\277\320\265\321\210\320\275\320\276 \320\276\321\202\320\277\321\200\320\260\320\262\320\273\320\265\320\275\320\260!</h3>\n                <p className=\"text-xs text-slate-300\">\n                  \320\234\321\213 \321\201\320\262\321\217\320\266\320\265\320\274\321\201\321\217 \321\201 \320\262\320\260\320\274\320\270 \320\262 \321\202\320\265\321\207\320\265\320\275\320\270\320\265 15 \320\274\320\270\320\275\321\203\321\202 \320\262 \321\200\320\260\320\261\320\276\321\207\320\265\320\265 \320\262\321\200\320\265\320\274\321\217.\n                </p>\n              </div>\n            ) : (\n              <form onSubmit={handleFeedbackSubmit} className=\"space-y-4\">\n                <div>\n                  <label className=\"block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1\">\n                    \320\222\320\260\321\210\320\265 \320\270\320\274\321\217\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={formName}\n                    onChange={e => setFormName(e.target.value)}\n                    placeholder=\"\320\220\320\273\320\265\320\272\321\201\320\265\320\271\"\n                    className=\"w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white outline-none focus:border-orange-500\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1\">\n                    \320\242\320\265\320\273\320\265\321\204\320\276\320\275 *\n                  </label>\n                  <input\n                    type=\"tel\"\n                    required\n                    value={formPhone}\n                    onChange={e => setFormPhone(e.target.value)}\n                    placeholder=\"+375 (33) 377-28-73\"\n                    className=\"w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white outline-none focus:border-orange-500\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1\">\n                    \320\241\320\276\320\276\320\261\321\211\320\265\320\275\320\270\320\265 / \320\227\320\260\320\277\321\200\320\276\321\201\n                  </label>\n                  <textarea\n                    rows={3}\n                    value={formMessage}\n                    onChange={e => setFormMessage(e.target.value)}\n                    placeholder=\"\320\243\320\272\320\260\320\266\320\270\321\202\320\265 \320\262\320\260\321\210 \320\267\320\260\320\277\321\200\320\276\321\201 \320\270\320\273\320\270 \321\201\320\277\320\270\321\201\320\276\320\272 \320\276\320\261\320\276\321\200\321\203\320\264\320\276\320\262\320\260\320\275\320\270\321\217...\"\n                    className=\"w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white outline-none focus:border-orange-500 resize-none\"\n                  />\n                </div>\n\n                <button\n                  type=\"submit\"\n                  className=\"w-full py-3 bg-gradient-to-r from-orange-500 to-amber-600 hover:from-orange-600 hover:to-amber-700 text-white font-bold rounded-xl text-xs flex items-center justify-center gap-2 shadow-lg shadow-orange-500/25 transition-all\"\n                >\n                  <Send className=\"w-4 h-4\" /> \320\236\321\202\320\277\321\200\320\260\320\262\320\270\321\202\321\214 \321\201\320\276\320\276\320\261\321\211\320\265\320\275\320\270\320\265\n                </button>\n              </form>\n            )}\n          </div>\n        </div>\n      </section>\n    </div>\n  );\n};\n"
    }
