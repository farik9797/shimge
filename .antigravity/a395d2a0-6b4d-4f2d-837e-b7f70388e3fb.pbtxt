    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { useApp } from \'../../context/AppContext\';\nimport { ChevronLeft, ChevronRight, ShieldCheck, Sparkles, ArrowRight, Zap, Volume2 } from \'lucide-react\';\n\nconst SLIDES = [\n  {\n    id: 1,\n    badge: \'\320\241\320\277\320\265\321\206\320\270\320\260\320\273\321\214\320\275\320\276\320\265 \320\277\321\200\320\265\320\264\320\273\320\276\320\266\320\265\320\275\320\270\320\265 B2B\',\n    title: \'\320\241\321\202\321\203\320\264\320\270\320\271\320\275\320\260\321\217 \320\270 \320\272\320\276\320\275\321\206\320\265\321\200\321\202\320\275\320\260\321\217 \320\260\320\272\321\203\321\201\321\202\320\270\320\272\320\260 \321\201 \320\235\320\224\320\241 20%\',\n    desc: \'\320\236\321\204\320\270\321\206\320\270\320\260\320\273\321\214\320\275\321\213\320\265 \320\277\320\276\321\201\321\202\320\260\320\262\320\272\320\270 \320\276\320\261\320\276\321\200\321\203\320\264\320\276\320\262\320\260\320\275\320\270\321\217 Yamaha, JBL, Shure \320\277\320\276 \320\221\320\265\320\273\320\260\321\200\321\203\321\201\320\270. \320\223\320\260\321\200\320\260\320\275\321\202\320\270\320\271\320\275\320\276\320\265 \320\276\320\261\321\201\320\273\321\203\320\266\320\270\320\262\320\260\320\275\320\270\320\265 \320\270 \320\277\321\200\320\276\320\265\320\272\321\202\320\275\321\213\320\271 \321\200\320\260\321\201\321\207\320\265\321\202.\',\n    ctaText: \'\320\241\320\274\320\276\321\202\321\200\320\265\321\202\321\214 \320\272\320\260\321\202\320\260\320\273\320\276\320\263\',\n    route: \'catalog\',\n    bgImage: \'https://images.unsplash.com/photo-1598488035139-bdbb2231ce04?auto=format&fit=crop&w=1600&q=80\',\n    highlight: \'\320\241\320\272\320\270\320\264\320\272\320\270 \320\264\320\276 -25%\'\n  },\n  {\n    id: 2,\n    badge: \'\320\243\321\201\320\273\321\203\320\263\320\260 \320\270\320\275\321\201\321\202\320\260\320\273\320\273\321\217\321\206\320\270\320\270\',\n    title: \'\320\237\321\200\320\276\320\265\320\272\321\202\320\270\321\200\320\276\320\262\320\260\320\275\320\270\320\265 \320\270 \320\260\320\272\321\203\321\201\321\202\320\270\321\207\320\265\321\201\320\272\320\270\320\271 \321\200\320\260\321\201\321\207\320\265\321\202 \320\277\320\276\320\274\320\265\321\211\320\265\320\275\320\270\320\271\',\n    desc: \'\320\236\320\267\320\262\321\203\321\207\320\270\320\262\320\260\320\275\320\270\320\265 \321\200\320\265\321\201\321\202\320\276\321\200\320\260\320\275\320\276\320\262, \321\201\320\277\320\276\321\200\321\202\320\270\320\262\320\275\321\213\321\205 \320\267\320\260\320\273\320\276\320\262, \320\272\320\276\320\275\321\204\320\265\321\200\320\265\320\275\321\206-\320\272\320\276\320\274\320\275\320\260\321\202 \320\270 \320\242\320\240\320\246 \302\253\320\277\320\276\320\264 \320\272\320\273\321\216\321\207\302\273. \320\222\321\213\320\265\320\267\320\264 \321\201\320\277\320\265\321\206\320\270\320\260\320\273\320\270\321\201\321\202\320\260 \320\262 \320\234\320\270\320\275\321\201\320\272\320\265 \320\270 \320\276\320\261\320\273\320\260\321\201\321\202\321\217\321\205.\',\n    ctaText: \'\320\227\320\260\320\272\320\260\320\267\320\260\321\202\321\214 \320\277\321\200\320\276\320\265\320\272\321\202\',\n    route: \'services\',\n    bgImage: \'https://images.unsplash.com/photo-1516280440614-37939bbacd81?auto=format&fit=crop&w=1600&q=80\',\n    highlight: \'\320\234\320\276\320\264\320\265\320\273\320\270\321\200\320\276\320\262\320\260\320\275\320\270\320\265 EASE\'\n  },\n  {\n    id: 3,\n    badge: \'\320\235\320\276\320\262\320\276\320\265 \320\277\320\276\321\201\321\202\321\203\320\277\320\273\320\265\320\275\320\270\320\265\',\n    title: \'\320\233\320\265\320\263\320\265\320\275\320\264\320\260\321\200\320\275\321\213\320\265 \320\274\320\270\320\272\321\200\320\276\321\204\320\276\320\275\321\213 Shure \320\270 \321\200\320\260\320\264\320\270\320\276\321\201\320\270\321\201\321\202\320\265\320\274\321\213\',\n    desc: \'\320\222\320\276\320\272\320\260\320\273\321\214\320\275\321\213\320\265 \320\274\320\270\320\272\321\200\320\276\321\204\320\276\320\275\321\213 SM7B, BETA 58A \320\270 \321\206\320\270\321\204\321\200\320\276\320\262\320\260\321\217 \321\200\320\260\320\264\320\270\320\276\321\201\320\270\321\201\321\202\320\265\320\274\320\260 SLX-D \321\203\320\266\320\265 \320\275\320\260 \321\201\320\272\320\273\320\260\320\264\320\265 \320\236\320\236\320\236 \302\253\320\220\321\200\321\202-\320\234\320\265\320\264\320\270\320\260 \320\242\321\200\320\265\320\271\320\264\302\273 \320\262 \320\234\320\270\320\275\321\201\320\272\320\265.\',\n    ctaText: \'\320\237\320\265\321\200\320\265\320\271\321\202\320\270 \320\272 \320\274\320\270\320\272\321\200\320\276\321\204\320\276\320\275\320\260\320\274\',\n    route: \'catalog\',\n    bgImage: \'https://images.unsplash.com/photo-1590602847861-f357a9332bbc?auto=format&fit=crop&w=1600&q=80\',\n    highlight: \'\320\223\320\260\321\200\320\260\320\275\321\202\320\270\321\217 24 \320\274\320\265\321\201\'\n  }\n];\n\nexport const HeroSlider: React.FC = () => {\n  const { setRoute, setFilters } = useApp();\n  const [currentSlide, setCurrentSlide] = useState(0);\n\n  useEffect(() => {\n    const timer = setInterval(() => {\n      setCurrentSlide(prev => (prev + 1) % SLIDES.length);\n    }, 6000);\n    return () => clearInterval(timer);\n  }, []);\n\n  const slide = SLIDES[currentSlide];\n\n  return (\n    <section className=\"relative bg-slate-950 text-white overflow-hidden rounded-3xl my-6 mx-4 max-w-7xl lg:mx-auto shadow-2xl border border-slate-800\">\n      {/* Background Image Container */}\n      <div className=\"absolute inset-0 z-0\">\n        <img\n          src={slide.bgImage}\n          alt={slide.title}\n          className=\"w-full h-full object-cover object-center opacity-30 transition-all duration-1000 transform scale-105\"\n        />\n        <div className=\"absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/80 to-transparent\"></div>\n      </div>\n\n      {/* Slide Content */}\n      <div className=\"relative z-10 max-w-3xl px-8 py-16 md:py-24 space-y-6\">\n        <div className=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-orange-500/20 text-orange-400 border border-orange-500/30 text-xs font-bold uppercase tracking-wider backdrop-blur-md\">\n          <Sparkles className=\"w-3.5 h-3.5\" />\n          {slide.badge}\n        </div>\n\n        <h1 className=\"text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight leading-tight text-white\">\n          {slide.title}\n        </h1>\n\n        <p className=\"text-sm sm:text-base text-slate-300 leading-relaxed max-w-xl\">\n          {slide.desc}\n        </p>\n\n        <div className=\"flex flex-wrap items-center gap-4 pt-2\">\n          <button\n            onClick={() => {\n              if (slide.route === \'catalog\') {\n                setFilters(prev => ({ ...prev, category: \'all\' }));\n              }\n              setRoute(slide.route as any);\n            }}\n            className=\"px-8 py-4 bg-gradient-to-r from-orange-500 to-amber-600 hover:from-orange-600 hover:to-amber-700 text-white font-extrabold rounded-2xl shadow-xl shadow-orange-500/30 flex items-center gap-3 transition-all transform hover:-translate-y-0.5 active:translate-y-0 text-sm\"\n          >\n            {slide.ctaText}\n            <ArrowRight className=\"w-4 h-4\" />\n          </button>\n\n          <div className=\"flex items-center gap-2 px-4 py-3 bg-slate-900/80 backdrop-blur border border-slate-800 rounded-2xl text-xs font-bold text-amber-400\">\n            <Zap className=\"w-4 h-4 text-amber-400 shrink-0\" />\n            {slide.highlight}\n          </div>\n        </div>\n      </div>\n\n      {/* Navigation Controls */}\n      <div className=\"absolute bottom-6 right-6 z-20 flex items-center gap-2\">\n        <button\n          onClick={() => setCurrentSlide((currentSlide - 1 + SLIDES.length) % SLIDES.length)}\n          className=\"p-3 rounded-full bg-slate-900/80 hover:bg-orange-600 text-white border border-slate-800 transition-colors\"\n          aria-label=\"\320\237\321\200\320\265\320\264\321\213\320\264\321\203\321\211\320\270\320\271 \321\201\320\273\320\260\320\271\320\264\"\n        >\n          <ChevronLeft className=\"w-5 h-5\" />\n        </button>\n        <span className=\"text-xs font-bold text-slate-400 px-2\">\n          0{currentSlide + 1} / 0{SLIDES.length}\n        </span>\n        <button\n          onClick={() => setCurrentSlide((currentSlide + 1) % SLIDES.length)}\n          className=\"p-3 rounded-full bg-slate-900/80 hover:bg-orange-600 text-white border border-slate-800 transition-colors\"\n          aria-label=\"\320\241\320\273\320\265\320\264\321\203\321\216\321\211\320\270\320\271 \321\201\320\273\320\260\320\271\320\264\"\n        >\n          <ChevronRight className=\"w-5 h-5\" />\n        </button>\n      </div>\n    </section>\n  );\n};\n"
    }
