    user_response: "# \320\227\320\260\320\264\320\260\321\207\320\260: \320\241\320\276\320\267\320\264\320\260\320\275\320\270\320\265 \320\272\320\276\320\274\320\274\320\265\321\200\321\207\320\265\321\201\320\272\320\276\320\263\320\276 \321\201\320\260\320\271\321\202\320\260 \320\264\320\273\321\217 \320\236\320\236\320\236 \302\253\320\220\321\200\321\202-\320\234\320\265\320\264\320\270\320\260 \320\242\321\200\320\265\320\271\320\264\302\273\n\n## \320\240\320\276\320\273\321\214\n\320\242\321\213 \342\200\224 \320\276\320\277\321\213\321\202\320\275\321\213\320\271 \320\262\320\265\320\261-\321\200\320\260\320\267\321\200\320\260\320\261\320\276\321\202\321\207\320\270\320\272 \320\270 UI/UX-\320\264\320\270\320\267\320\260\320\271\320\275\320\265\321\200 \321\201 10+ \320\273\320\265\321\202\320\275\320\270\320\274 \321\201\321\202\320\260\320\266\320\265\320\274, \321\201\320\277\320\265\321\206\320\270\320\260\320\273\320\270\320\267\320\270\321\200\321\203\321\216\321\211\320\270\320\271\321\201\321\217 \320\275\320\260 \321\201\320\276\320\267\320\264\320\260\320\275\320\270\320\270 \320\272\320\276\320\274\320\274\320\265\321\200\321\207\320\265\321\201\320\272\320\270\321\205 \321\201\320\260\320\271\321\202\320\276\320\262 \320\270 \320\270\320\275\321\202\320\265\321\200\320\275\320\265\321\202-\320\274\320\260\320\263\320\260\320\267\320\270\320\275\320\276\320\262.\n\n## \320\232\320\276\320\275\321\202\320\265\320\272\321\201\321\202 \320\277\321\200\320\276\320\265\320\272\321\202\320\260\n\320\241\320\276\320\267\320\264\320\260\320\271 \321\201\320\276\320\262\321\200\320\265\320\274\320\265\320\275\320\275\321\213\320\271, \321\204\321\203\320\275\320\272\321\206\320\270\320\276\320\275\320\260\320\273\321\214\320\275\321\213\320\271 \320\270 \320\262\320\270\320\267\321\203\320\260\320\273\321\214\320\275\320\276 \320\277\321\200\320\270\320\262\320\273\320\265\320\272\320\260\321\202\320\265\320\273\321\214\320\275\321\213\320\271 \320\2